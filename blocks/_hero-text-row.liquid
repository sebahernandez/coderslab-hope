{%- doc -%}
  Un texto del Hero Banner (título, subtítulo o descripción). Reúne en un solo lugar toda la
  configuración de tipografía que antes estaba repetida por rol en la sección. La etiqueta HTML
  es configurable para conservar la semántica (h1/h2/…). Los valores dinámicos viajan como
  variables CSS en el atributo `style`; el CSS estático vive en `{% stylesheet %}`.
{%- enddoc -%}
{%- liquid
  assign self_align = block.settings.alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
  assign self_align_mobile = block.settings.alignment_mobile | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
-%}
<{{ block.settings.tag }}
  class="hero-text-row"
  style="{% render 'hero-font-vars', prefix: 'text', font: block.settings.font, font_type: block.settings.font_type, custom_name: block.settings.custom_font_name, custom_weight: block.settings.custom_font_weight, weight: block.settings.weight, bold: block.settings.bold, include_style: true %}
         color: {{ block.settings.color }};
         --text-size: {{ block.settings.font_size }}px;
         --text-size-mobile: {{ block.settings.font_size_mobile }}px;
         --text-lh: {{ block.settings.line_height }};
         --text-lh-mobile: {{ block.settings.line_height_mobile }};
         --text-spacing: {{ block.settings.spacing_bottom }}px;
         --text-transform: {{ block.settings.text_transform }};
         --text-letter-spacing: {{ block.settings.letter_spacing }}px;
         --text-max-width: {% if block.settings.max_width > 0 %}{{ block.settings.max_width }}px{% else %}none{% endif %};
         --text-align: {{ block.settings.alignment }};
         --text-self: {{ self_align }};
         --text-align-mobile: {{ block.settings.alignment_mobile }};
         --text-self-mobile: {{ self_align_mobile }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.convert_newlines -%}
    {{ block.settings.content | newline_to_br }}
  {%- else -%}
    {{ block.settings.content }}
  {%- endif -%}
</{{ block.settings.tag }}>

{% style %}
  {% render 'hero-font-face', font_type: block.settings.font_type, font: block.settings.font, custom_name: block.settings.custom_font_name, custom_url: block.settings.custom_font_url, custom_weight: block.settings.custom_font_weight, weight: block.settings.weight, bold: block.settings.bold %}
{% endstyle %}

{% stylesheet %}
.hero-text-row {
  font-family: var(--text-font-family);
  font-size: var(--text-size, 1rem);
  font-weight: var(--text-font-weight, 400);
  font-style: var(--text-font-style, normal);
  line-height: var(--text-lh, 1.4);
  letter-spacing: var(--text-letter-spacing, 0);
  text-transform: var(--text-transform, none);
  max-width: var(--text-max-width, none);
  margin: 0 0 var(--text-spacing, 0px) 0;
  padding: 0;
  text-align: var(--text-align, left);
  align-self: var(--text-self, flex-start);
}

@media screen and (max-width: 768px) {
  .hero-text-row {
    font-size: var(--text-size-mobile, var(--text-size, 1rem));
    line-height: var(--text-lh-mobile, var(--text-lh, 1.4));
    text-align: var(--text-align-mobile, var(--text-align, left));
    align-self: var(--text-self-mobile, var(--text-self, flex-start));
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Texto del Hero",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "content",
      "label": "Contenido",
      "default": "Texto del hero"
    },
    {
      "type": "checkbox",
      "id": "convert_newlines",
      "label": "Convertir saltos de línea en <br>",
      "info": "Actívalo para que cada Enter genere un salto de línea real (recomendado para el título).",
      "default": false
    },
    {
      "type": "select",
      "id": "tag",
      "label": "Etiqueta HTML (semántica)",
      "options": [
        { "value": "h1", "label": "H1 (título principal)" },
        { "value": "h2", "label": "H2 (subtítulo)" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Párrafo" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color del texto",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Transformación",
      "options": [
        { "value": "none", "label": "Normal" },
        { "value": "uppercase", "label": "MAYÚSCULAS" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Espaciado entre letras",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 = sin límite."
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "select",
      "id": "font_type",
      "label": "Origen de la fuente",
      "options": [
        { "value": "theme", "label": "Fuente de Shopify" },
        { "value": "custom", "label": "Fuente personalizada (URL / @font-face)" }
      ],
      "default": "theme"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Tipografía (Shopify)",
      "info": "Se usa cuando el origen es 'Fuente de Shopify'. También aporta las fuentes de respaldo.",
      "default": "inter_n7"
    },
    {
      "type": "text",
      "id": "custom_font_name",
      "label": "Nombre de la fuente personalizada",
      "visible_if": "{{ block.settings.font_type == 'custom' }}"
    },
    {
      "type": "url",
      "id": "custom_font_url",
      "label": "URL del archivo de fuente",
      "info": "Sube el .woff2/.woff/.ttf a Contenido → Archivos y pega su URL.",
      "visible_if": "{{ block.settings.font_type == 'custom' }}"
    },
    {
      "type": "select",
      "id": "custom_font_weight",
      "label": "Peso real del archivo",
      "options": [
        { "value": "auto", "label": "Normal" },
        { "value": "100", "label": "100" },
        { "value": "200", "label": "200" },
        { "value": "300", "label": "300" },
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" },
        { "value": "800", "label": "800" },
        { "value": "900", "label": "900" }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.font_type == 'custom' }}"
    },
    {
      "type": "select",
      "id": "weight",
      "label": "Grosor aplicado",
      "info": "Si la familia no incluye ese grosor, se usa el más cercano disponible en lugar de simularlo.",
      "options": [
        { "value": "auto", "label": "Automático (según fuente)" },
        { "value": "100", "label": "100 - Thin" },
        { "value": "200", "label": "200 - Extra Light" },
        { "value": "300", "label": "300 - Light" },
        { "value": "400", "label": "400 - Regular" },
        { "value": "500", "label": "500 - Medium" },
        { "value": "600", "label": "600 - Semi Bold" },
        { "value": "700", "label": "700 - Bold" },
        { "value": "800", "label": "800 - Extra Bold" },
        { "value": "900", "label": "900 - Black" }
      ],
      "default": "auto"
    },
    {
      "type": "checkbox",
      "id": "bold",
      "label": "Negrita",
      "info": "Solo se aplica si el grosor está en 'Automático'. Usa la variante negrita real de la fuente, si la familia la tiene.",
      "default": false
    },
    {
      "type": "header",
      "content": "Tamaño y espaciado"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tamaño (Escritorio)",
      "min": 10,
      "max": 110,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Tamaño (Mobile)",
      "min": 8,
      "max": 108,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Altura de línea (Escritorio)",
      "min": 0.8,
      "max": 3,
      "step": 0.1,
      "default": 1.3
    },
    {
      "type": "range",
      "id": "line_height_mobile",
      "label": "Altura de línea (Mobile)",
      "min": 0.8,
      "max": 3,
      "step": 0.1,
      "default": 1.3
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "Separación con el elemento siguiente. Ponlo en 0 para controlar la altura solo con la altura de línea."
    },
    {
      "type": "header",
      "content": "Alineación"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación (Escritorio)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Alineación (Mobile)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Texto del Hero"
    }
  ]
}
{% endschema %}
