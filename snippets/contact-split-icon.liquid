{% doc %}
  Renders an inline SVG social/utility icon by name.
  @param {string} name - Icon key: instagram, facebook, whatsapp, messenger, tiktok, x, youtube, email, chevron
  @example
  {% render 'contact-split-icon', name: 'instagram' %}
{% enddoc %}

{%- case name -%}
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="2" width="20" height="20" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M14 8.5V7c0-.7.3-1 1-1h1.5V3H14c-2.2 0-3.5 1.4-3.5 3.7V8.5H8V11.5h2.5V21H14v-9.5h2.2l.3-3H14z"/>
    </svg>
  {%- when 'whatsapp' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.4-1.1-2.7s.7-1.9 1-2.2c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.5c-.1.2-.3.3-.1.6.1.3.7 1.1 1.5 1.8 1 .9 1.8 1.1 2 1.2.3.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.1.1.7-.1 1.3z"/>
    </svg>
  {%- when 'messenger' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.5 8.5 0 1 1-3.7-7L21 3l-1 3.6"/>
      <path d="M7.5 12.5l3-3 2.5 2 3-2.5-3 3-2.5-2z"/>
    </svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16 3c.3 2 1.6 3.6 3.5 3.9V10c-1.3 0-2.5-.4-3.5-1v6.2A5.2 5.2 0 1 1 10.8 10v3.1a2.2 2.2 0 1 0 2.2 2.2V3H16z"/>
    </svg>
  {%- when 'x' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.5 3h3l-6.6 7.6L21.7 21h-5.9l-4.3-5.6L6.5 21H3.4l7-8-6.9-10h6l3.9 5.2L17.5 3zm-1 16h1.6L8 4.6H6.3L16.5 19z"/>
    </svg>
  {%- when 'youtube' -%}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1c.3-1.3.4-2.5.4-3.8s-.1-2.5-.4-3.8zM10 15V9l5.2 3L10 15z"/>
    </svg>
  {%- when 'email' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"/>
      <path d="m3 7 9 6 9-6"/>
    </svg>
  {%- when 'chevron' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/>
    </svg>
{%- endcase -%}
