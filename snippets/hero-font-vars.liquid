{%- doc -%}
  Emite variables CSS de tipografía (`--{prefix}-font-family/weight/style`) para un texto del
  Hero Banner, resolviendo la variante real de la fuente para no pedir un peso inexistente
  (que haría que el navegador simule la negrita). Pensado para usarse dentro de un atributo
  `style` o de un tag `{% style %}`.

  @param {string} prefix - Prefijo de las variables CSS (ej. 'text', 'button').
  @param {font} font - Objeto font de Shopify (font_picker). Aporta las familias de respaldo.
  @param {string} font_type - 'theme' o 'custom'.
  @param {string} [custom_name] - Nombre de la fuente personalizada (@font-face).
  @param {string} [custom_weight] - Peso real del archivo custom ('auto' o 100..900).
  @param {string} weight - Grosor aplicado ('auto' o 100..900).
  @param {boolean} [bold] - Negrita cuando el grosor está en 'auto'.
  @param {boolean} [include_style] - Si emite tambien `--{prefix}-font-style`.

  @example
  {% render 'hero-font-vars', prefix: 'text', font: block.settings.font,
     font_type: block.settings.font_type, custom_name: block.settings.custom_font_name,
     custom_weight: block.settings.custom_font_weight, weight: block.settings.weight,
     bold: block.settings.bold, include_style: true %}
{%- enddoc -%}
{%- liquid
  assign variant = false
  unless font_type == 'custom'
    if weight != 'auto'
      assign variant = font | font_modify: 'weight', weight
    elsif bold
      assign variant = font | font_modify: 'weight', 'bolder'
    endif
  endunless
  assign applied = variant | default: font

  if font_type == 'custom' and custom_name != blank
    assign css_family = "'" | append: custom_name | append: "', " | append: font.fallback_families
    if weight != 'auto'
      assign css_weight = weight
    elsif custom_weight != 'auto'
      assign css_weight = custom_weight
    else
      assign css_weight = 400
    endif
    assign css_style = 'normal'
  else
    assign css_family = "'" | append: applied.family | append: "', " | append: applied.fallback_families
    assign css_weight = applied.weight
    assign css_style = applied.style
  endif
-%}
--{{ prefix }}-font-family: {{ css_family }};
--{{ prefix }}-font-weight: {{ css_weight }};
{%- if include_style %}
--{{ prefix }}-font-style: {{ css_style }};
{%- endif -%}
