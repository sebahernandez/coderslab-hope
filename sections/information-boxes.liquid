{%- liquid
  assign align = section.settings.content_alignment
  if align == 'left'
    assign flex_align = 'flex-start'
  elsif align == 'right'
    assign flex_align = 'flex-end'
  else
    assign flex_align = 'center'
  endif

  assign heading_align = section.settings.heading_alignment
  if heading_align == blank or heading_align == 'inherit'
    assign heading_align = align
  endif

  assign heading_font = section.settings.heading_font
  if section.settings.heading_weight == 'normal'
    assign heading_weight = 400
  elsif section.settings.heading_weight == 'bold'
    assign heading_weight = 700
  else
    assign heading_weight = heading_font.weight
  endif
-%}

{% style %}
  /* Tipografías seleccionadas en el personalizador */
  {{ heading_font | font_face: font_display: 'swap' }}
  {% if heading_weight >= 600 %}{{ heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}{% endif %}

  {%- for block in section.blocks -%}
    {%- liquid
      assign title_font = block.settings.title_font
      assign text_font = block.settings.text_font

      if block.settings.title_weight == 'normal'
        assign title_weight = 400
      elsif block.settings.title_weight == 'bold'
        assign title_weight = 700
      else
        assign title_weight = title_font.weight
      endif

      assign title_align = block.settings.title_alignment
      assign title_has_own_align = true
      if title_align == blank or title_align == 'inherit'
        assign title_has_own_align = false
      endif

      if block.settings.text_weight == 'normal'
        assign text_weight = 400
      elsif block.settings.text_weight == 'bold'
        assign text_weight = 700
      else
        assign text_weight = text_font.weight
      endif
    -%}
    {{ title_font | font_face: font_display: 'swap' }}
    {% if title_weight >= 600 %}{{ title_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}{% endif %}
    {{ text_font | font_face: font_display: 'swap' }}
    {% if text_weight >= 600 %}{{ text_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}{% endif %}

    #information-boxes-{{ section.id }} #information-box-{{ block.id }} .information-box__title {
      font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
      font-style: {{ title_font.style }};
      font-weight: {{ title_weight }};
      {%- if title_has_own_align %}
      align-self: stretch;
      width: 100%;
      text-align: {{ title_align }};
      {%- endif %}
    }

    #information-boxes-{{ section.id }} #information-box-{{ block.id }} .information-box__text {
      font-family: {{ text_font.family }}, {{ text_font.fallback_families }};
      font-style: {{ text_font.style }};
      font-weight: {{ text_weight }};
    }
  {%- endfor -%}

  /* Sección padre: rompe el ancho del contenedor y pinta el fondo a todo el ancho del viewport (full-bleed) */
  #information-boxes-{{ section.id }} {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background: var(--ib-background);
    padding-top: var(--ib-padding-top, 60px);
    padding-bottom: var(--ib-padding-bottom, 60px);
    box-sizing: border-box;
  }

  /* Contenedor centrado con el page-width oficial del tema */
  #information-boxes-{{ section.id }} .information-boxes__inner {
    width: 100%;
    max-width: var(--ib-page-width, 1200px);
    margin-inline: auto;
    padding-inline: 20px;
    box-sizing: border-box;
  }

  #information-boxes-{{ section.id }} .information-boxes__heading {
    text-align: {{ heading_align }};
    margin: 0 0 40px;
    color: var(--ib-heading-color);
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-weight: {{ heading_weight }};
    font-size: var(--ib-heading-size, 32px);
  }

  /* Grid de cajas */
  #information-boxes-{{ section.id }} .information-boxes__grid {
    display: grid;
    grid-template-columns: repeat(var(--ib-columns, 3), minmax(0, 1fr));
    gap: var(--ib-gap, 24px);
    width: 100%;
  }

  /* Caja individual: flexbox en columna alineado con el setting */
  #information-boxes-{{ section.id }} .information-box {
    display: flex;
    flex-direction: column;
    align-items: {{ flex_align }};
    text-align: {{ align }};
    background: var(--box-bg, transparent);
    color: var(--box-color, inherit);
    border-radius: var(--box-radius, 12px);
    padding: var(--box-padding, 24px);
    box-sizing: border-box;
    height: 100%;
  }

  #information-boxes-{{ section.id }} .information-box__icon {
    display: block;
    width: var(--icon-size, 56px);
    height: var(--icon-size, 56px);
    object-fit: contain;
    padding: var(--icon-padding, 0);
    box-sizing: content-box;
  }

  #information-boxes-{{ section.id }} .information-box__title {
    margin: 0;
    font-size: var(--title-size, 20px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--title-color, inherit);
    padding: var(--title-padding, 12px 0 0);
  }

  #information-boxes-{{ section.id }} .information-box__text {
    font-size: var(--text-size, 15px);
    line-height: 1.6;
    color: var(--text-color, inherit);
    padding: var(--text-padding, 8px 0 0);
  }

  #information-boxes-{{ section.id }} .information-box__text p {
    margin: 0 0 0.5em;
  }
  #information-boxes-{{ section.id }} .information-box__text p:last-child {
    margin-bottom: 0;
  }

  #information-boxes-{{ section.id }} .information-box__icon--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
  }

  /* Tablet */
  @media screen and (max-width: 989px) {
    #information-boxes-{{ section.id }} .information-boxes__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Móvil: una columna */
  @media screen and (max-width: 749px) {
    #information-boxes-{{ section.id }} .information-boxes__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<section
  id="information-boxes-{{ section.id }}"
  class="information-boxes"
  style="
    --ib-background: {% if section.settings.background_gradient != blank %}{{ section.settings.background_gradient }}{% else %}{{ section.settings.background_color }}{% endif %};
    --ib-page-width: {{ section.settings.page_width }}px;
    --ib-columns: {{ section.settings.columns }};
    --ib-gap: {{ section.settings.gap }}px;
    --ib-padding-top: {{ section.settings.padding_top }}px;
    --ib-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ib-heading-color: {{ section.settings.heading_color }};
    --ib-heading-size: {{ section.settings.heading_size }}px;
  "
>
  <div class="information-boxes__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="information-boxes__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="information-boxes__grid">
        {%- for block in section.blocks -%}
          <div
            id="information-box-{{ block.id }}"
            class="information-box"
            style="
              --box-bg: {{ block.settings.box_background }};
              --box-color: {{ block.settings.content_color }};
              --box-radius: {{ block.settings.box_radius }}px;
              --box-padding: {{ block.settings.box_padding_top }}px {{ block.settings.box_padding_right }}px {{ block.settings.box_padding_bottom }}px {{ block.settings.box_padding_left }}px;
              --icon-size: {{ block.settings.icon_size }}px;
              --icon-padding: {{ block.settings.icon_padding_top }}px {{ block.settings.icon_padding_right }}px {{ block.settings.icon_padding_bottom }}px {{ block.settings.icon_padding_left }}px;
              --title-size: {{ block.settings.title_size }}px;
              --title-color: {{ block.settings.title_color }};
              --title-padding: {{ block.settings.title_padding_top }}px {{ block.settings.title_padding_right }}px {{ block.settings.title_padding_bottom }}px {{ block.settings.title_padding_left }}px;
              --text-size: {{ block.settings.text_size }}px;
              --text-color: {{ block.settings.text_color }};
              --text-padding: {{ block.settings.text_padding_top }}px {{ block.settings.text_padding_right }}px {{ block.settings.text_padding_bottom }}px {{ block.settings.text_padding_left }}px;
            "
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.icon != blank -%}
              <img
                class="information-box__icon"
                src="{{ block.settings.icon | image_url: width: 200 }}"
                alt="{{ block.settings.icon.alt | escape }}"
                width="{{ block.settings.icon_size }}"
                height="{{ block.settings.icon_size }}"
                loading="lazy"
              >
            {%- elsif block.settings.show_icon_placeholder -%}
              <div class="information-box__icon information-box__icon--placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="information-box__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="information-box__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cajas de información",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Título de la sección",
      "default": "<p>Nuestros beneficios</p>"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Tipografía del título de la sección",
      "default": "anonymous_pro_n4"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Grosor del título de la sección",
      "options": [
        { "value": "auto", "label": "Según la tipografía" },
        { "value": "normal", "label": "Normal (400)" },
        { "value": "bold", "label": "Negrita (700)" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título de la sección",
      "min": 14,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alineación del título de la sección",
      "options": [
        { "value": "inherit", "label": "Igual que la sección" },
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "inherit"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Fondo (pantalla completa)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#f6f6f6"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Degradado de fondo",
      "info": "Si defines un degradado, este tiene prioridad sobre el color de fondo."
    },
    {
      "type": "header",
      "content": "Diseño del contenedor"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Ancho máximo del contenedor",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas (escritorio)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre cajas",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineación del contenido (flexbox)",
      "info": "Alinea el icono, el título y el texto de todas las cajas.",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Espaciado de la sección"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "Caja",
      "settings": [
        {
          "type": "header",
          "content": "Icono"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icono"
        },
        {
          "type": "checkbox",
          "id": "show_icon_placeholder",
          "label": "Mostrar marcador si no hay icono",
          "default": true
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Tamaño del icono",
          "min": 16,
          "max": 160,
          "step": 2,
          "unit": "px",
          "default": 56
        },
        {
          "type": "range",
          "id": "icon_padding_top",
          "label": "Padding superior (icono)",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "icon_padding_right",
          "label": "Padding derecho (icono)",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "icon_padding_bottom",
          "label": "Padding inferior (icono)",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "icon_padding_left",
          "label": "Padding izquierdo (icono)",
          "min": 0,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "header",
          "content": "Título"
        },
        {
          "type": "text",
