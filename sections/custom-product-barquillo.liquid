{%- comment -%}
  Section contract.
  Armador dedicado del producto "Barquillo": cono de vainilla + 1 sirope.
  Clon aislado de custom-product-v2 (sin tamaño ni toppings). El precio es 100% nativo por
  variante "Extras premium" (0 = sirope estándar/sin elegir, 1 = sirope premium) y se agrega
  al carrito como UNA sola línea con la property "Sirope". Los siropes salen de la categoría
  "Sirope" del metafield custom.opciones_customizador del producto.
  Sabor del mes: si hay un sabor vigente (metaobjeto sabor_del_mes, mismas reglas que
  custom-product-v2) se muestra el banner y un selector de base (clásica / sabor del mes) antes
  de los siropes; la elección va en la property "Base" y no cambia precio ni variante. Sin sabor
  vigente no se renderiza nada de esto. Si la entrada trae el campo JSON `imagenes_barquilla`
  ({ "base": url, "siropes": { id: url } }), se expone en [data-barq-flavor-previews] para que
  la imagen principal muestre el sabor con el sirope elegido.
  Cada item puede traer `imagen_barquillo` (URL de la foto del cono con ese sirope); la
  sección expone el mapa { id: url } en [data-barq-syrup-previews] y el JS cambia la imagen
  principal al elegir un sirope (sin campo, se mantiene la imagen base).
  Usa data-hopecfg-barq (nunca data-hopecfg ni data-hopecfg-v2) para que ni
  toppings-customizer.js ni hope-customizer-v2.js inicialicen esta raíz.
  @example
  <!-- Se alcanza desde templates/product.barquillo.json (templateSuffix "barquillo") -->
{%- endcomment -%}

{{ 'hope-customizer-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'barquillo-customizer.js' | asset_url }}" defer></script>

{%- liquid
  assign p_barq = product | default: closest.product
  assign cfg_cats = p_barq.metafields.custom.opciones_customizador.value.categorias
  assign cat_sirope = cfg_cats | where: 'nombre', 'Sirope' | first

  assign titulo_dinamico = section.settings.titulo
  if titulo_dinamico == blank
    if p_barq.title
      assign titulo_dinamico = 'Crea tu ' | append: p_barq.title
    else
      assign titulo_dinamico = 'Crea tu Barquillo'
    endif
  endif

  assign base_image_val = section.settings.base_image_url
  if base_image_val == blank
    assign base_image_val = 'https://res.cloudinary.com/slealu5f/image/upload/v1793205910/Cono_de_vainilla_en_espiral_ah6axq.png'
  endif

  # Sabor del mes: el forzado gana; si no, la entrada vigente (inicio <= hoy <= fin) cuyo
  # `producto` esté vacío o sea este producto. Vinculada al producto gana a sin vincular;
  # empate -> inicio más reciente. Las vinculadas a otro producto se omiten.
  assign flavor = nil
  if section.settings.mostrar_sabor_del_mes
    if section.settings.sabor_del_mes_forzado != blank
      assign flavor = section.settings.sabor_del_mes_forzado
    else
      assign today = 'now' | date: '%Y-%m-%d'
      assign flavor_key = ''
      for entry in metaobjects.sabor_del_mes.values
        assign entry_product = entry.producto.value
        if entry_product == blank
          assign entry_rank = '0'
        elsif entry_product.id == p_barq.id
          assign entry_rank = '1'
        else
          continue
        endif
        assign entry_start = entry.fecha_inicio.value | date: '%Y-%m-%d'
        assign entry_end = entry.fecha_fin.value | date: '%Y-%m-%d'
        assign entry_key = entry_rank | append: '|' | append: entry_start
        if entry_start <= today and entry_end >= today and entry_key > flavor_key
          assign flavor = entry
          assign flavor_key = entry_key
        endif
      endfor
    endif
  endif

  assign flavor_image_url = ''
  assign classic_thumb_url = ''
  if flavor
    # Imagen del cono del sabor como URL completa (cloudinary_vaso gana a imagen_vaso).
    # Espeja catalogUrl() de hope-customizer-v2.js.
    assign flavor_cup_asset = flavor.cloudinary_vaso.value | strip
    if flavor_cup_asset != blank
      assign flavor_cloud = section.settings.cloudinary_account | default: 'slealu5f'
      assign flavor_folder = section.settings.cloudinary_folder | default: 'hope/catalog'
      assign flavor_transform = 'f_auto,q_auto,w_1000'
      assign flavor_cup_prefix = flavor_cup_asset | slice: 0, 3
      if flavor_cup_prefix == '2d-' or flavor_cup_asset == 'hope-mixo-fixed-default-v1'
        assign flavor_transform = 'e_background_removal/' | append: flavor_transform
      endif
      assign flavor_image_url = 'https://res.cloudinary.com/' | append: flavor_cloud | append: '/image/upload/' | append: flavor_transform | append: '/' | append: flavor_folder | append: '/' | append: flavor_cup_asset
    elsif flavor.imagen_vaso.value != blank
      assign flavor_image_url = flavor.imagen_vaso.value | image_url: width: 1000
    endif

    # Fotos del cono con este sabor: { "base": url, "siropes": { idSirope: url } } (campo JSON
    # opcional `imagenes_barquilla` de la entrada). El JS las usa en la vista previa.
    assign flavor_previews = flavor.imagenes_barquilla.value
    assign flavor_thumb = flavor.miniatura.value
    assign flavor_thumb_url = flavor_previews.base
    assign flavor_option_sub = flavor.subtitulo_opcion.value | default: 'Sabor del Mes · Edición Limitada'
    assign flavor_name = flavor.nombre.value
    assign classic_name = section.settings.base_clasica_nombre | default: 'Yogurt Griego Clásico'
    if section.settings.base_clasica_miniatura != blank
      assign classic_thumb_url = section.settings.base_clasica_miniatura | image_url: width: 160
    else
      assign classic_thumb_url = base_image_val
    endif
  endif
-%}

{%- capture products_json -%}
{
  {%- if p_barq -%}
  "barquillo": {
    "id": {{ p_barq.id }},
    "handle": {{ p_barq.handle | json }},
    "variants": [
      {%- for v in p_barq.variants -%}
        {"id": {{ v.id }}, "option1": {{ v.option1 | json }}, "price": {{ v.price }}, "price_formatted": {{ v.price | money | strip_html | json }}, "available": {{ v.available }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  {%- endif -%}
}
{%- endcapture -%}

{%- capture syrup_previews_json -%}
{
  {%- assign first_preview = true -%}
  {%- for item in cat_sirope.items -%}
    {%- if item.imagen_barquillo != blank -%}
      {%- unless first_preview -%},{%- endunless -%}
      {{ item.id | json }}: {{ item.imagen_barquillo | json }}
      {%- assign first_preview = false -%}
    {%- endif -%}
  {%- endfor -%}
}
{%- endcapture -%}

<div
  class="hopecfg hopecfg--v2 hopecfg--barquillo"
  data-hopecfg-barq
  data-modo="barquillo"
  data-shop-domain="{{ shop.permanent_domain | escape }}"
  data-delivery-availability-url="{{ section.settings.delivery_availability_url | default: 'https://back.hopeicecream.shop/api/v1/store-operations/delivery-availability' | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-cloudinary-account="{{ section.settings.cloudinary_account | default: 'slealu5f' | escape }}"
  data-cloudinary-folder="{{ section.settings.cloudinary_folder | default: 'hope/catalog' | escape }}"
  data-base-image="{{ base_image_val | escape }}"
  {%- if flavor %}
    data-flavor-name="{{ flavor_name | escape }}"
    data-flavor-image="{{ flavor_image_url | escape }}"
    data-classic-name="{{ classic_name | escape }}"
  {%- endif %}
>
  <script type="application/json" data-hopecfg-products>{{ products_json }}</script>
  <script type="application/json" data-barq-syrup-previews>{{ syrup_previews_json }}</script>
  {%- if flavor and flavor_previews != blank %}
    <script type="application/json" data-barq-flavor-previews>{{ flavor_previews | json }}</script>
  {%- endif %}

  <div class="hopecfg__frame">
    {%- comment -%} ===== Panel de vista previa ===== {%- endcomment -%}
    <section class="hopecfg__preview" id="preview-panel" data-view="2d">
      {%- if section.settings.logo != blank -%}
        <div class="hopecfg__brand" id="brand-badge">
          <img
            class="hopecfg__brand-logo"
            src="{{ section.settings.logo | image_url: width: 320 }}"
            alt="{{ shop.name | escape }}"
            width="160"
            height="auto"
            loading="eager"
          >
        </div>
      {%- endif -%}

      <div class="hopecfg__stage">
        <img
          width=""
          height=""
          id="product-preview"
          class="hopecfg__cup"
          data-mode="2d"
          alt="{{ p_barq.title | default: shop.name | escape }}"
          decoding="async"
        >
        {%- if flavor -%}
          <span class="hope2__flavor-badge" data-flavor-badge aria-hidden="true">Sabor<br>del Mes</span>
        {%- endif -%}
      </div>
    </section>

    {%- comment -%} ===== Panel de configuración ===== {%- endcomment -%}
    <section class="hopecfg__config" id="config-panel" data-view="2d">
      <div class="hopecfg__config-scroll">
        <div class="hopecfg__heading">
          <p class="hopecfg__eyebrow">{{ section.settings.eyebrow | default: 'Barquillo de vainilla' }}</p>
          <h2 class="hopecfg__title">{{ titulo_dinamico }}</h2>
        </div>

        {%- render 'hope-delivery-notice' -%}

        <div id="hope-options" class="hopecfg__groups">
          {%- if flavor -%}
            <div id="base-step" class="hopecfg__group hope2__base-step">
              {%- render 'hope-flavor-banner', flavor: flavor -%}
              <fieldset id="base-options" class="hope2__base-group" data-group="base">
                <legend class="hopecfg__legend">
                  <span class="hopecfg__legend-title">Elige la base del helado</span>
                </legend>
                <div class="hope2__base-grid">
                  <button class="hopecfg__choice hope2__base-choice is-active" data-id="clasico" type="button" aria-pressed="true">
                    <span class="hopecfg__check"></span>
                    <img class="hope2__base-thumb" src="{{ classic_thumb_url | escape }}" alt="" width="48" height="48" loading="lazy">
                    <span class="hope2__base-text">
                      <span class="hope2__base-name">{{ classic_name | escape }}</span>
                      <span class="hope2__base-sub">{{ section.settings.base_clasica_subtitulo | default: 'Nuestro sabor tradicional' | escape }}</span>
                    </span>
                  </button>
                  <button class="hopecfg__choice hope2__base-choice" data-id="mes" type="button" aria-pressed="false">
                    <span class="hopecfg__check"></span>
                    {%- if flavor_thumb != blank -%}
                      {{ flavor_thumb | image_url: width: 160 | image_tag: class: 'hope2__base-thumb', alt: '', width: 48, height: 48, loading: 'lazy' }}
                    {%- elsif flavor_thumb_url != blank -%}
                      <img class="hope2__base-thumb" src="{{ flavor_thumb_url | escape }}" alt="" width="48" height="48" loading="lazy">
                    {%- elsif flavor.imagen_banner.value != blank -%}
                      {{ flavor.imagen_banner.value | image_url: width: 160 | image_tag: class: 'hope2__base-thumb', alt: '', width: 48, height: 48, loading: 'lazy' }}
                    {%- endif -%}
                    <span class="hope2__base-text">
                      <span class="hope2__base-name">{{ flavor_name | escape }}</span>
                      <span class="hope2__base-sub">{{ flavor_option_sub | escape }}</span>
                    </span>
                  </button>
                </div>
              </fieldset>
            </div>
          {%- endif -%}
          <fieldset id="syrup-options" class="hopecfg__group" data-group="syrup">
            <legend class="hopecfg__legend">
              <span class="hopecfg__legend-title">Elige tu sirope</span>
              <span class="hopecfg__legend-count" data-syrup-count>0/1</span>
            </legend>
            <p class="hopecfg__barq-note">Tu barquilla lleva 1 sirope. Los premium suman $1.00.</p>

            {%- comment -%}
              Dos conjuntos: clásicos (orden del metafield) y premium (alfabético, para que
              las familias "Crema…", "Variegato…" queden juntas). El costo va en el
              encabezado del conjunto, no repetido en cada chip.
            {%- endcomment -%}
            {%- assign syrups_sorted = cat_sirope.items | sort_natural: 'nombre' -%}
            {%- capture syrup_chips_standard -%}
              {%- for item in cat_sirope.items -%}
                {%- unless item.premium -%}
                  {%- render 'hope-extra-chip', item: item, tipo: 'syrup' -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- capture syrup_chips_premium -%}
              {%- for item in syrups_sorted -%}
                {%- if item.premium -%}
                  {%- render 'hope-extra-chip', item: item, tipo: 'syrup' -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- if syrup_chips_standard != blank -%}
              <div class="hopecfg__barq-set" role="group" aria-labelledby="barq-set-standard-{{ section.id }}">
                <p class="hopecfg__barq-subhead" id="barq-set-standard-{{ section.id }}">
                  <span>Clásicos</span>
                  <span class="hopecfg__barq-cost hopecfg__barq-cost--included">Incluido</span>
                </p>
                <div class="hopecfg__barq-grid">{{ syrup_chips_standard }}</div>
              </div>
            {%- endif -%}

            {%- if syrup_chips_premium != blank -%}
              <div class="hopecfg__barq-set" role="group" aria-labelledby="barq-set-premium-{{ section.id }}">
                <p class="hopecfg__barq-subhead" id="barq-set-premium-{{ section.id }}">
                  <span>Premium <span class="hopecfg__star" aria-hidden="true">★</span></span>
                  <span class="hopecfg__barq-cost">+$1.00</span>
                </p>
                <div class="hopecfg__barq-grid">{{ syrup_chips_premium }}</div>
              </div>
            {%- endif -%}
          </fieldset>

          <div class="hope2__hint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15l-1.9-4.1L5.5 9l4.6-1.4L12 3z"/>
              <path d="M19 14l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8.8-2z"/>
            </svg>
            <span>{{ section.settings.hint_text | default: 'La foto cambia para mostrarte tu barquilla con el sirope que elijas' }}</span>
          </div>
        </div>
      </div>

      <footer class="hopecfg__footer">
        <div class="hopecfg__total">
          <p class="hopecfg__total-label">Total</p>
          <p id="price" class="hopecfg__price">—</p>
          <p id="extras-breakdown" class="hopecfg__extras-breakdown"></p>
          <p id="buy-hint" class="hopecfg__buy-hint"></p>
        </div>
        <div class="hopecfg__actions">
          <button id="reset-view" type="button" class="hopecfg__reset" aria-label="Reiniciar" title="Reiniciar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 11a8 8 0 1 0-2.34 5.66" />
              <path d="M20 4v7h-7" />
            </svg>
          </button>
          <button id="buy" type="button" class="hopecfg__buy">
            <span data-buy-label>{{ section.settings.texto_boton | default: 'AÑADIR AL CARRITO' }}</span>
            <svg class="hopecfg__buy-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="21" r="1" />
              <circle cx="20" cy="21" r="1" />
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
            </svg>
          </button>
        </div>
      </footer>
    </section>
  </div>

  <dialog
    class="hope2__availability-modal"
    aria-labelledby="barq-availability-title-{{ section.id }}"
    aria-describedby="barq-availability-description-{{ section.id }}"
  >
    <div class="hope2__availability-card">
      <div class="hope2__availability-icons" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 3h15v13H1z" />
          <path d="M16 8h4l3 3v5h-7V8z" />
          <circle cx="5.5" cy="18.5" r="2.5" />
          <circle cx="18.5" cy="18.5" r="2.5" />
          <path d="M3 21 21 3" />
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 10h18v11H3z" />
          <path d="M2 10 4 3h16l2 7" />
          <path d="M9 21v-7h6v7" />
          <path d="M2 10c0 2 3 3 5 1 2 2 4 2 5 0 1 2 3 2 5 0 2 2 5 1 5-1" />
        </svg>
      </div>
      <h3 id="barq-availability-title-{{ section.id }}">Opciones de entrega no disponibles</h3>
      <p id="barq-availability-description-{{ section.id }}">En este momento no contamos con delivery ni retiro en tienda.<br>Por favor, vuelve a intentarlo más tarde.</p>
      <button type="button" class="hope2__availability-accept" data-availability-accept>Entendido</button>
    </div>
  </dialog>

  <div id="toast" class="hopecfg__toast" role="status" aria-live="polite">¡Tu selección fue añadida! ✨</div>
</div>

{% stylesheet %}
  /* Un solo grupo: el wizard móvil de v2 oculta los grupos sin data-step, aquí siempre visible. */
  .hopecfg--v2.hopecfg--barquillo .hopecfg__group {
    display: block;
  }

  /* Sabor del mes: separación entre el bloque de base y el fieldset de siropes. */
  .hopecfg--barquillo .hope2__base-step {
    margin-block-end: 1.5rem;
  }

  .hopecfg--barquillo .hopecfg__barq-note {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #b56487;
  }

  /* ---- Siropes: dos conjuntos (clásicos / premium) en grilla uniforme ---- */
  .hopecfg--barquillo .hopecfg__barq-set + .hopecfg__barq-set {
    margin-block-start: 1.25rem;
    padding-block-start: 1rem;
    border-block-start: 1px dashed #f1d5e0;
  }

  .hopecfg--barquillo .hopecfg__barq-subhead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--hopecfg-ink, #392f36);
  }

  .hopecfg--barquillo .hopecfg__barq-cost {
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--hopecfg-hope, #ed5d96);
  }

  .hopecfg--barquillo .hopecfg__barq-cost--included {
    color: #2f9e6f;
  }

  .hopecfg--barquillo .hopecfg__barq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.5rem;
  }

  /* Especificidad alta a propósito: supera las reglas móviles de v2 para
     `#syrup-options .hopecfg__choice` (lista vertical) sin tocar el CSS compartido. */
  .hopecfg--v2.hopecfg--barquillo .hopecfg__config #syrup-options .hopecfg__barq-grid .hopecfg__choice {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6rem;
    width: 100%;
    min-width: 0;
    min-height: 3.5rem;
    padding: 0.4rem 0.7rem 0.4rem 0.4rem;
    border-radius: 12px;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.25;
    text-align: start;
    white-space: normal;
    overflow-wrap: break-word;
  }

  .hopecfg--v2.hopecfg--barquillo .hopecfg__config #syrup-options .hopecfg__barq-grid .hopecfg__choice .topping-icon {
    flex-shrink: 0;
    line-height: 0;
  }

  .hopecfg--v2.hopecfg--barquillo .hopecfg__config #syrup-options .hopecfg__barq-grid .hopecfg__choice .topping-img {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 9px;
    object-fit: cover;
  }

  /* El costo ya está en el encabezado del conjunto. */
  .hopecfg--barquillo .hopecfg__barq-grid .hopecfg__star,
  .hopecfg--barquillo .hopecfg__barq-grid .hopecfg__premium-tag {
    display: none;
  }

  /* El JS agrega "Incluido" / "+$1.00" al chip elegido; en la grilla angosta le
     quita ancho al nombre y repite el encabezado y el desglose del total. */
  .hopecfg--barquillo .hopecfg__barq-grid .hopecfg__chip-price {
    display: none;
  }

  /* Móvil: dos columnas de ~156px. Tipografía y miniatura un punto más chicas para
     que los nombres largos entren en 3 líneas como máximo. */
  @media (max-width: 749px) {
    .hopecfg--v2.hopecfg--barquillo .hopecfg__config #syrup-options .hopecfg__barq-grid .hopecfg__choice {
      gap: 0.5rem;
      padding: 0.4rem 0.5rem 0.4rem 0.4rem;
      font-size: 0.75rem;
      line-height: 1.3;
    }

    .hopecfg--v2.hopecfg--barquillo .hopecfg__config #syrup-options .hopecfg__barq-grid .hopecfg__choice .topping-img {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  @media (min-width: 1024px) {
    .hopecfg--barquillo .hopecfg__barq-grid {
      grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
      gap: 0.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Configurador Barquillo",
  "settings": [
    {
      "type": "header",
      "content": "Marca y textos"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior (eyebrow)",
      "default": "Barquillo de vainilla"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título (opcional)",
      "info": "Si se deja vacío, se usa \"Crea tu \" + el nombre del producto."
    },
    {
      "type": "text",
      "id": "texto_boton",
      "label": "Texto botón carrito",
      "default": "AÑADIR AL CARRITO"
    },
    {
      "type": "text",
      "id": "delivery_availability_url",
      "label": "URL de disponibilidad de entrega",
      "default": "https://back.hopeicecream.shop/api/v1/store-operations/delivery-availability"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Texto del aviso del sirope",
      "default": "La foto cambia para mostrarte tu barquilla con el sirope que elijas"
    },
    {
      "type": "header",
      "content": "Sabor del mes"
    },
    {
      "type": "checkbox",
