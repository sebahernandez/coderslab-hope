{%- comment -%}
  Section contract.
  Armador dedicado del producto "Barquillo": cono de vainilla + 1 sirope.
  Clon aislado de custom-product-v2 (sin tamaño ni toppings). El precio es 100% nativo por
  variante "Extras premium" (0 = sirope estándar/sin elegir, 1 = sirope premium) y se agrega
  al carrito como UNA sola línea con la property "Sirope". Los siropes salen de la categoría
  "Sirope" del metafield custom.opciones_customizador del producto.
  Usa data-hopecfg-barq (nunca data-hopecfg ni data-hopecfg-v2) para que ni
  toppings-customizer.js ni hope-customizer-v2.js inicialicen esta raíz.
  @example
  <!-- Se alcanza desde templates/product.barquillo.json (templateSuffix "barquillo") -->
{%- endcomment -%}

{{ 'hope-customizer-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'barquillo-customizer.js' | asset_url }}" defer></script>

{%- liquid
  assign p_barq = product | default: closest.product
  assign cfg_cats = p_barq.metafields.custom.opciones_customizador.value.categorias
  assign cat_sirope = cfg_cats | where: 'nombre', 'Sirope' | first

  assign titulo_dinamico = section.settings.titulo
  if titulo_dinamico == blank
    if p_barq.title
      assign titulo_dinamico = 'Crea tu ' | append: p_barq.title
    else
      assign titulo_dinamico = 'Crea tu Barquillo'
    endif
  endif

  assign base_image_val = section.settings.base_image_url
  if base_image_val == blank
    assign base_image_val = 'https://res.cloudinary.com/slealu5f/image/upload/v1793205910/Cono_de_vainilla_en_espiral_ah6axq.png'
  endif
-%}

{%- capture products_json -%}
{
  {%- if p_barq -%}
  "barquillo": {
    "id": {{ p_barq.id }},
    "handle": {{ p_barq.handle | json }},
    "variants": [
      {%- for v in p_barq.variants -%}
        {"id": {{ v.id }}, "option1": {{ v.option1 | json }}, "price": {{ v.price }}, "price_formatted": {{ v.price | money | strip_html | json }}, "available": {{ v.available }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  {%- endif -%}
}
{%- endcapture -%}

<div
  class="hopecfg hopecfg--v2 hopecfg--barquillo"
  data-hopecfg-barq
  data-modo="barquillo"
  data-shop-domain="{{ shop.permanent_domain | escape }}"
  data-delivery-availability-url="{{ section.settings.delivery_availability_url | default: 'https://back.hopeicecream.shop/api/v1/store-operations/delivery-availability' | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-cloudinary-account="{{ section.settings.cloudinary_account | default: 'slealu5f' | escape }}"
  data-cloudinary-folder="{{ section.settings.cloudinary_folder | default: 'hope/catalog' | escape }}"
  data-base-image="{{ base_image_val | escape }}"
>
  <script type="application/json" data-hopecfg-products>{{ products_json }}</script>

  <div class="hopecfg__frame">
    {%- comment -%} ===== Panel de vista previa ===== {%- endcomment -%}
    <section class="hopecfg__preview" id="preview-panel" data-view="2d">
      {%- if section.settings.logo != blank -%}
        <div class="hopecfg__brand" id="brand-badge">
          <img
            class="hopecfg__brand-logo"
            src="{{ section.settings.logo | image_url: width: 320 }}"
            alt="{{ shop.name | escape }}"
            width="160"
            height="auto"
            loading="eager"
          >
        </div>
      {%- endif -%}

      <div class="hopecfg__stage">
        <img
          width=""
          height=""
          id="product-preview"
          class="hopecfg__cup"
          data-mode="2d"
          alt="{{ p_barq.title | default: shop.name | escape }}"
          decoding="async"
        >
        <div id="hope-bubbles" class="hope2__bubbles" aria-hidden="true"></div>
      </div>

      <div class="hopecfg__extras" id="extras-panel">
        <div class="hopecfg__extras-inner">
          <div class="hope2__extras-copy">
            <p class="hope2__extras-eyebrow">Tu barquillo</p>
            <p id="hope-extras-label" class="hopecfg__extras-label">Aún sin sirope</p>
          </div>
          <div id="hope-stack" class="hopecfg__stack"></div>
        </div>
      </div>
    </section>

    {%- comment -%} ===== Panel de configuración ===== {%- endcomment -%}
    <section class="hopecfg__config" id="config-panel" data-view="2d">
      <div class="hopecfg__config-scroll">
        <div class="hopecfg__heading">
          <p class="hopecfg__eyebrow">{{ section.settings.eyebrow | default: 'Barquillo de vainilla' }}</p>
          <h2 class="hopecfg__title">{{ titulo_dinamico }}</h2>
        </div>

        <div class="hope2__delivery-notice" role="note" aria-live="polite">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 3h15v13H1z" />
            <path d="M16 8h4l3 3v5h-7V8z" />
            <circle cx="5.5" cy="18.5" r="2.5" />
            <circle cx="18.5" cy="18.5" r="2.5" />
          </svg>
          <span>Consultando disponibilidad...</span>
        </div>

        <div id="hope-options" class="hopecfg__groups">
          <fieldset id="syrup-options" class="hopecfg__group" data-group="syrup">
            <legend class="hopecfg__legend">
              <span class="hopecfg__legend-title">Elige tu sirope</span>
              <span class="hopecfg__legend-count" data-syrup-count>0/1</span>
            </legend>
            <p class="hopecfg__barq-note">Incluye 1 sirope estándar. Sirope premium (★) +$1.00</p>
            <div class="hopecfg__chips">
              {%- for item in cat_sirope.items -%}
                {%- render 'hope-extra-chip', item: item, tipo: 'syrup' -%}
              {%- endfor -%}
            </div>
          </fieldset>

          <div class="hope2__hint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15l-1.9-4.1L5.5 9l4.6-1.4L12 3z"/>
              <path d="M19 14l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8.8-2z"/>
            </svg>
            <span>{{ section.settings.hint_text | default: 'Tu sirope aparece sobre el barquillo con un +1' }}</span>
          </div>
        </div>
      </div>

      <footer class="hopecfg__footer">
        <div class="hopecfg__total">
          <p class="hopecfg__total-label">Total</p>
          <p id="price" class="hopecfg__price">—</p>
          <p id="extras-breakdown" class="hopecfg__extras-breakdown"></p>
          <p id="buy-hint" class="hopecfg__buy-hint"></p>
        </div>
        <div class="hopecfg__actions">
          <button id="reset-view" type="button" class="hopecfg__reset" aria-label="Reiniciar" title="Reiniciar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 11a8 8 0 1 0-2.34 5.66" />
              <path d="M20 4v7h-7" />
            </svg>
          </button>
          <button id="buy" type="button" class="hopecfg__buy">
            <span data-buy-label>{{ section.settings.texto_boton | default: 'AÑADIR AL CARRITO' }}</span>
            <svg class="hopecfg__buy-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="21" r="1" />
              <circle cx="20" cy="21" r="1" />
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
            </svg>
          </button>
        </div>
      </footer>
    </section>
  </div>

  <dialog
    class="hope2__availability-modal"
    aria-labelledby="barq-availability-title-{{ section.id }}"
    aria-describedby="barq-availability-description-{{ section.id }}"
  >
    <div class="hope2__availability-card">
      <div class="hope2__availability-icons" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 3h15v13H1z" />
          <path d="M16 8h4l3 3v5h-7V8z" />
          <circle cx="5.5" cy="18.5" r="2.5" />
          <circle cx="18.5" cy="18.5" r="2.5" />
          <path d="M3 21 21 3" />
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 10h18v11H3z" />
          <path d="M2 10 4 3h16l2 7" />
          <path d="M9 21v-7h6v7" />
          <path d="M2 10c0 2 3 3 5 1 2 2 4 2 5 0 1 2 3 2 5 0 2 2 5 1 5-1" />
        </svg>
      </div>
      <h3 id="barq-availability-title-{{ section.id }}">Opciones de entrega no disponibles</h3>
      <p id="barq-availability-description-{{ section.id }}">En este momento no contamos con delivery ni retiro en tienda.<br>Por favor, vuelve a intentarlo más tarde.</p>
      <button type="button" class="hope2__availability-accept" data-availability-accept>Entendido</button>
    </div>
  </dialog>

  <div id="toast" class="hopecfg__toast" role="status" aria-live="polite">¡Tu selección fue añadida! ✨</div>
</div>

{% stylesheet %}
  /* Un solo grupo: el wizard móvil de v2 oculta los grupos sin data-step, aquí siempre visible. */
  .hopecfg--v2.hopecfg--barquillo .hopecfg__group {
    display: block;
  }

  .hopecfg--barquillo .hopecfg__barq-note {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #b56487;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Configurador Barquillo",
  "settings": [
    {
      "type": "header",
      "content": "Marca y textos"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior (eyebrow)",
      "default": "Barquillo de vainilla"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título (opcional)",
      "info": "Si se deja vacío, se usa \"Crea tu \" + el nombre del producto."
    },
    {
      "type": "text",
      "id": "texto_boton",
      "label": "Texto botón carrito",
      "default": "AÑADIR AL CARRITO"
    },
    {
      "type": "text",
      "id": "delivery_availability_url",
      "label": "URL de disponibilidad de entrega",
      "default": "https://back.hopeicecream.shop/api/v1/store-operations/delivery-availability"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Texto del aviso del sirope",
      "default": "Tu sirope aparece sobre el barquillo con un +1"
    },
    {
      "type": "header",
      "content": "Imágenes"
    },
    {
      "type": "text",
      "id": "base_image_url",
      "label": "URL de la imagen base del cono — opcional",
      "info": "Si se deja vacío, usa el cono de vainilla en espiral de Cloudinary."
    },
    {
      "type": "text",
      "id": "cloudinary_account",
      "label": "Cloud name",
      "default": "slealu5f"
    },
    {
      "type": "text",
      "id": "cloudinary_folder",
      "label": "Carpeta del catálogo",
      "default": "hope/catalog"
    }
  ],
  "presets": [
    {
      "name": "Configurador Barquillo"
    }
  ]
}
{% endschema %}
