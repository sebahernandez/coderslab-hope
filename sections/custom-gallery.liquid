<style>
.icecream-collage .grid-container {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-template-rows: repeat(3, minmax(80px, auto));
  gap: 15px;
  align-items: stretch;
  padding: 20px;
}

.icecream-collage .item img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Cambia a contain si lo prefieres */
  border-radius: 8px;
}

/* Colores fijos */
.pink1 { background: #f8c8dc; }
.pink2 { background: #f2a9c2; }
.pink3 { background: #e07aa6; }
.pink4 { background: #f5b2d1; }
.pink5 { background: #d96b91; }

/* Disposición según la imagen adjunta - 7 imágenes + 7 colores */
.img1 { grid-column: 1 / 4; grid-row: 1 / 4; }      /* Imagen grande izquierda */
.color1 { grid-column: 4 / 6; grid-row: 1 / 2; }    /* Bloque rosa pequeño */
.img2 { grid-column: 6 / 8; grid-row: 1 / 3; }      /* Imagen personas */
.color2 { grid-column: 8 / 10; grid-row: 1 / 2; }   /* Bloque rosa pequeño */
.img3 { grid-column: 10 / 13; grid-row: 1 / 4; }    /* Imagen helado decorado */
.color3 { grid-column: 12 / 13; grid-row: 1 / 4; }  /* Bloque rosa alto */

.img4 { grid-column: 4 / 6; grid-row: 2 / 4; }      /* Imagen helado chocolate */
.color4 { grid-column: 6 / 8; grid-row: 3 / 4; }    /* Bloque rosa pequeño */
.img5 { grid-column: 8 / 10; grid-row: 2 / 4; }     /* Imagen helado copa */
.color5 { grid-column: 10 / 12; grid-row: 3 / 4; }  /* Bloque rosa pequeño */

.color-block { 
  border-radius: 8px; 
  min-height: 120px;
  min-width: 80px;
}


/* Responsive */
@media (max-width: 1024px) {
  .icecream-collage .grid-container {
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, minmax(60px, auto));
  }
  
  .img1 { grid-column: 1 / 3; grid-row: 1 / 3; }
  .color1 { grid-column: 3 / 4; grid-row: 1 / 2; }
  .img2 { grid-column: 4 / 6; grid-row: 1 / 2; }
  .color2 { grid-column: 6 / 8; grid-row: 1 / 2; }
  .img3 { grid-column: 8 / 9; grid-row: 1 / 3; }
  .color3 { grid-column: 1 / 2; grid-row: 3 / 5; }
  .img4 { grid-column: 2 / 4; grid-row: 3 / 4; }
  .color4 { grid-column: 4 / 5; grid-row: 3 / 4; }
  .img5 { grid-column: 5 / 7; grid-row: 3 / 5; }
  .color5 { grid-column: 7 / 9; grid-row: 3 / 4; }
}

@media (max-width: 768px) {
  .icecream-collage .grid-container {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(10, minmax(80px, auto));
    gap: 10px;
  }
  
  .img1 { grid-column: 1 / 3; grid-row: 1 / 3; }
  .color1 { grid-column: 3 / 4; grid-row: 1 / 2; }
  .img2 { grid-column: 4 / 5; grid-row: 1 / 2; }
  .color2 { grid-column: 3 / 5; grid-row: 2 / 3; }
  .img3 { grid-column: 1 / 3; grid-row: 3 / 4;}
  .color3 { grid-column: 2 / 3; grid-row: 3 / 4; }
  .img4 { grid-column: 3 / 5; grid-row: 3 / 5; }
  .color4 { grid-column: 1 / 3; grid-row: 4 / 5;}
  .img5 { grid-column: 1 / 3; grid-row: 5 / 7; }
  .color5 { grid-column: 3 / 4; grid-row: 5 / 6; }
  
  .color-block {
    min-height: 80px;
    min-width: 40px;
  }
}
</style>

<section class="icecream-collage">
  <div class="section section-page">
    <div class="grid-container">
    <!-- Primera fila -->
    <div class="item img1">
      {% if section.settings.image1 %}
        <img src="{{ section.settings.image1 | image_url: width:800 }}" alt="icecream 1" width="{{ section.settings.image1.width }}" height="{{ section.settings.image1.height }}">
      {% endif %}
    </div>
    
    <div class="color-block color1 pink1"></div>
    
    <div class="item img2">
      {% if section.settings.image2 %}
        <img src="{{ section.settings.image2 | image_url: width:800 }}" alt="icecream 2" width="{{ section.settings.image2.width }}" height="{{ section.settings.image2.height }}">
      {% endif %}
    </div>
    
    <div class="color-block color2 pink2"></div>
    
    <div class="item img3">
      {% if section.settings.image3 %}
        <img src="{{ section.settings.image3 | image_url: width:800 }}" alt="icecream 3" width="{{ section.settings.image3.width }}" height="{{ section.settings.image3.height }}">
      {% endif %}
    </div>
    
    <!-- Segunda fila -->
    <div class="item img4">
      {% if section.settings.image4 %}
        <img src="{{ section.settings.image4 | image_url: width:800 }}" alt="icecream 4" width="{{ section.settings.image4.width }}" height="{{ section.settings.image4.height }}">
      {% endif %}
    </div>
    
    <div class="color-block color4 pink4"></div>
    
    <div class="item img5">
      {% if section.settings.image5 %}
        <img src="{{ section.settings.image5 | image_url: width:800 }}" alt="icecream 5" width="{{ section.settings.image5.width }}" height="{{ section.settings.image5.height }}">
      {% endif %}
    </div>
    
    
  </div>
  </div>
</section>



{% schema %}
{
  "name": "Custom Gallery",
  "settings": [
    {
      "type": "image_picker",
      "id": "image1",
      "label": "Imagen 1"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Imagen 2"
    },
    {
      "type": "image_picker",
      "id": "image3",
      "label": "Imagen 3"
    },
    {
      "type": "image_picker",
      "id": "image4",
      "label": "Imagen 4"
    },
    {
      "type": "image_picker",
      "id": "image5",
      "label": "Imagen 5"
    }
  ],
  "presets": [
    {
      "name": "Collage de Helados",
      "category": "Collage"
    }
  ]
}
{% endschema %}
