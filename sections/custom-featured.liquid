{% comment %}
  Section: Paso 1 - Elige tu base
{% endcomment %}

<section class="choose-base ">
  <div class="section section-page">
    <!-- Encabezado -->
    <div class="header">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>

    <!-- Grid de opciones -->
    <div class="base-grid">
      {% for block in section.blocks %}
        <div class="base-card">
          <div class="image-wrapper">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 600 }}" 
                alt="{{ block.settings.title }}" 
                style="object-fit: {{ block.settings.image_fit | default: 'cover' }};"
                width="{{ block.settings.image.width }}" 
                height="{{ block.settings.image.height }}">
            {% endif %}
            <div class="text-overlay">
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Featured",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título principal",
      "default": "Paso 1: Elige tu base"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Helado de yogurt cremoso, preparado al momento y personalizado a tu gusto. Elige entre frutas frescas, siropes, galletas, cereales y más, para crear tu combinación perfecta."
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Altura de imagen (px)",
      "min": 200,
      "max": 600,
      "step": 10,
      "default": 300,
      "info": "Controla la altura de todas las imágenes en píxeles"
    }
  ],
  "blocks": [
    {
      "type": "base_item",
      "name": "Opción base",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "HELADO"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Un postre en capas que sorprende en cada cucharada. Capas de yogurt helado mezcladas con frutas jugosas, galletas, salsas artesanales y más."
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Ajuste de imagen",
          "default": "cover",
          "options": [
            {
              "value": "cover",
              "label": "Cubrir (Cover)"
            },
            {
              "value": "contain",
              "label": "Contener (Contain)"
            },
            {
              "value": "fill",
              "label": "Rellenar (Fill)"
            },
            {
              "value": "scale-down",
              "label": "Escalar hacia abajo"
            },
            {
              "value": "none",
              "label": "Sin ajuste"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Custom Featured",
      "category": "Secciones Personalizadas"
    }
  ]
}
{% endschema %}

<style>
.choose-base {
  padding: 3rem 1rem;
}

.choose-base .header {
  text-align: center;
  margin-bottom: 2rem;
}

.choose-base h2 {
  font-size: 1.8rem;
  color: #d44c91; /* tono rosado como en la imagen */
}

.choose-base p {
  max-width: 700px;
  margin: 0 auto;
  font-size: 1rem;
  color: #444;
}

.base-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
}

.base-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  border-radius: 12px;
}

.base-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

.base-card .image-wrapper {
  width: 100%;
  height: {{ section.settings.image_height | default: 300 }}px; /* Altura controlable desde el admin */
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.base-card:hover .image-wrapper {
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
}

.base-card img {
  width: 100%;
  height: 100%;
  border-radius: 12px;
  /* object-fit se aplica dinámicamente desde el template */
}

.text-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.8) 0%,
    rgba(0, 0, 0, 0.6) 50%,
    rgba(0, 0, 0, 0.3) 80%,
    transparent 100%
  );
  color: white;
  padding: 2rem 1.5rem 1.5rem;
  transition: opacity 0.3s ease;
}

.base-card:hover .text-overlay {
  opacity: 1;
}

.text-overlay h3 {
  font-size: 1.4rem;
  font-weight: bold;
  margin: 0 0 0.5rem 0;
  color: white;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
}

.text-overlay p {
  font-size: 0.95rem;
  color: rgba(255, 255, 255, 0.9);
  margin: 0;
  line-height: 1.4;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

/* Responsive Design */
@media (max-width: 768px) {
  .base-card .image-wrapper {
    height: calc({{ section.settings.image_height | default: 300 }}px * 0.83); /* 83% de la altura original en tablets */
  }
  
  .text-overlay {
    padding: 1.5rem 1rem 1rem;
  }
  
  .text-overlay h3 {
    font-size: 1.2rem;
  }
  
  .text-overlay p {
    font-size: 0.9rem;
  }
}

@media (max-width: 480px) {
  .base-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .base-card .image-wrapper {
    height: calc({{ section.settings.image_height | default: 300 }}px * 0.67); /* 67% de la altura original en móviles */
  }
  
  .text-overlay {
    padding: 1rem 0.8rem 0.8rem;
  }
  
  .text-overlay h3 {
    font-size: 1.1rem;
  }
  
  .text-overlay p {
    font-size: 0.85rem;
    line-height: 1.3;
  }
}
</style>
