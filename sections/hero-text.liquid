{% style %}
  #shopify-section-{{ section.id }} .hero-banner-section {
    background-color: {{ section.settings.background_color }};
    {% if section.settings.background_image != blank %}--hero-bg-image: url('{{ section.settings.background_image | image_url }}');{% endif %}
    {% if section.settings.background_image_mobile != blank %}--hero-bg-image-mobile: url('{{ section.settings.background_image_mobile | image_url }}');{% endif %}
    {% if section.settings.height_type == 'full' %}
      --hero-height: 100vh;
      --hero-height-mobile: 100vh;
    {% elsif section.settings.height_type == 'custom' %}
      --hero-height: {{ section.settings.height_custom }}{{ section.settings.height_unit }};
      --hero-height-mobile: {{ section.settings.height_custom_mobile }}{{ section.settings.height_unit_mobile }};
    {% else %}
      --hero-height: auto;
      --hero-height-mobile: auto;
    {% endif %}
    --hero-min-height: {% if section.settings.height_type == 'auto' %}{{ section.settings.min_height }}px{% else %}var(--hero-height){% endif %};
    --hero-min-height-mobile: {% if section.settings.height_type == 'auto' %}{{ section.settings.min_height_mobile }}px{% else %}var(--hero-height-mobile){% endif %};
  }
{% endstyle %}

<div class="hero-banner-section" data-section-id="{{ section.id }}">
  <div class="hero-banner-container section--page-width section">
    <div class="hero-banner-content">

      {%- if section.settings.show_image and section.settings.image != blank -%}
        <div class="hero-banner-image">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt }}"
            loading="lazy"
            width="auto"
            height="auto"
          >
        </div>
      {%- endif -%}

      <div class="hero-banner-text">
        {% content_for 'blocks' %}
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
.hero-banner-section {
  background-image: var(--hero-bg-image, none);
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  width: 100%;
  height: var(--hero-height, auto);
  min-height: var(--hero-min-height, 700px);
  display: flex;
  align-items: center;
}

.hero-banner-content {
  display: flex;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
}

.hero-banner-image {
  flex: 0 0 auto;
  max-width: 400px;
}

.hero-banner-text {
  flex: 1;
  min-width: 300px;
  display: flex;
  flex-direction: column;
}

@media screen and (max-width: 768px) {
  .hero-banner-section {
    padding: 40px 15px;
    height: var(--hero-height-mobile, auto);
    min-height: var(--hero-min-height-mobile, 400px);
    background-image: var(--hero-bg-image-mobile, var(--hero-bg-image, none));
  }

  .hero-banner-content {
    flex-direction: column;
    gap: 30px;
  }

  .hero-banner-image {
    max-width: 300px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner Helados",
  "blocks": [
    { 
      "type": "_hero-text-row" 
    },
    { 
      "type": "_hero-button" 
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Altura de la Sección"
    },
    {
      "type": "select",
      "id": "height_type",
      "label": "Tipo de Altura",
      "options": [
        { "value": "auto", "label": "Automática (según contenido)" },
        { "value": "full", "label": "Pantalla completa (100vh)" },
        { "value": "custom", "label": "Personalizada" }
      ],
      "default": "auto",
      "info": "Elige cómo se calcula la altura de la sección"
    },
    {
      "type": "header",
      "content": "Altura Automática — Mínimo"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Altura Mínima (Escritorio)",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 700,
      "info": "Solo aplica cuando el tipo de altura es 'Automática'"
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Altura Mínima (Mobile)",
      "min": 150,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 400,
      "info": "Solo aplica cuando el tipo de altura es 'Automática'"
    },
    {
      "type": "header",
      "content": "Altura Personalizada"
    },
    {
      "type": "range",
      "id": "height_custom",
      "label": "Altura Personalizada (Escritorio)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 80,
      "info": "Solo aplica cuando el tipo de altura es 'Personalizada'. La unidad se elige abajo."
    },
    {
      "type": "select",
      "id": "height_unit",
      "label": "Unidad (Escritorio)",
      "options": [
        { "value": "vh", "label": "vh (% de la pantalla)" },
        { "value": "rem", "label": "rem" },
        { "value": "px", "label": "px" }
      ],
      "default": "vh"
    },
    {
      "type": "range",
      "id": "height_custom_mobile",
      "label": "Altura Personalizada (Mobile)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 60,
      "info": "Solo aplica cuando el tipo de altura es 'Personalizada'. La unidad se elige abajo."
    },
    {
      "type": "select",
      "id": "height_unit_mobile",
      "label": "Unidad (Mobile)",
      "options": [
        { "value": "vh", "label": "vh (% de la pantalla)" },
        { "value": "rem", "label": "rem" },
        { "value": "px", "label": "px" }
      ],
      "default": "vh"
    },
    {
      "type": "header",
      "content": "Colores de Fondo"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de Fondo",
      "default": "#FFB6D9"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen de Fondo",
      "info": "Opcional. Si se agrega, se mostrará sobre el color de fondo"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Imagen de Fondo (Mobile)",
      "info": "Opcional. Si se agrega, reemplaza a la Imagen de Fondo solo en mobile (768px o menos)"
    },
    {
      "type": "header",
      "content": "Imagen Principal"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Mostrar Imagen",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Helados",
      "category": "Custom",
      "blocks": [
        {
          "type": "_hero-text-row",
          "settings": {
            "content": "HELADOS ARTESANALES",
            "convert_newlines": true,
            "tag": "h1",
            "color": "#FFFFFF",
            "text_transform": "uppercase",
            "letter_spacing": 1,
            "font": "inter_n7",
            "weight": "auto",
            "bold": true,
            "font_size": 40,
            "font_size_mobile": 24,
            "line_height": 1.2,
            "line_height_mobile": 1.2
          }
        },
        {
          "type": "_hero-text-row",
          "settings": {
            "content": "CON SABOR A FELICIDAD",
            "tag": "h2",
            "color": "#FFFFFF",
            "text_transform": "uppercase",
            "font": "inter_n7",
            "font_size": 32,
            "font_size_mobile": 20,
            "line_height": 1.3,
            "line_height_mobile": 1.3
          }
        },
        {
          "type": "_hero-text-row",
          "settings": {
            "content": "Endulzamos cada rincón de Tucacas con sabores que te roban sonrisas. Pide con Retiro en tienda o disfruta nuestro Delivery directo a tu puerta.",
            "tag": "div",
            "color": "#FFFFFF",
            "max_width": 600,
            "font": "inter_n4",
            "font_size": 16,
            "font_size_mobile": 14,
            "line_height": 1.6,
            "line_height_mobile": 1.6
          }
        },
        {
          "type": "_hero-button",
          "settings": {
            "label": "ARMA TU HELADO",
            "text_color": "#FF69B4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
