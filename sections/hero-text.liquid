{% style %}
  #shopify-section-{{ section.id }} .hero-banner-section {
    background-color: {{ section.settings.background_color }};
    {% if section.settings.background_image != blank %}--hero-bg-image: url('{{ section.settings.background_image | image_url }}');{% endif %}
    {% if section.settings.background_image_mobile != blank %}--hero-bg-image-mobile: url('{{ section.settings.background_image_mobile | image_url }}');{% endif %}
    {% if section.settings.height_type == 'full' %}
      --hero-height: 100vh;
      --hero-height-mobile: 100vh;
    {% elsif section.settings.height_type == 'custom' %}
      --hero-height: {{ section.settings.height_custom }}{{ section.settings.height_unit }};
      --hero-height-mobile: {{ section.settings.height_custom_mobile }}{{ section.settings.height_unit_mobile }};
    {% else %}
      --hero-height: auto;
      --hero-height-mobile: auto;
    {% endif %}
    --hero-min-height: {% if section.settings.height_type == 'auto' %}{{ section.settings.min_height }}px{% else %}var(--hero-height){% endif %};
    --hero-min-height-mobile: {% if section.settings.height_type == 'auto' %}{{ section.settings.min_height_mobile }}px{% else %}var(--hero-height-mobile){% endif %};
    {% if section.settings.enable_cloud_motion %}
      --cloud-cup-size: {{ section.settings.clouds_cup_size | default: 30 }}%;
      --cloud-cup-size-mobile: {{ section.settings.clouds_cup_size_mobile | default: 58 }}%;
    {% endif %}
  }
{% endstyle %}

<div class="hero-banner-section{% if section.settings.enable_cloud_motion %} hero-banner-section--clouds{% endif %}" data-section-id="{{ section.id }}"{% if section.settings.enable_cloud_motion %} data-cup-align="{{ section.settings.clouds_cup_align | default: 'center' }}"{% endif %}>

  {%- if section.settings.enable_cloud_motion -%}
    <div class="hero-clouds" aria-hidden="true">
      {%- if section.settings.clouds_sky_url != blank -%}
        <div class="hero-clouds__sky" style="background-image: url('{{ section.settings.clouds_sky_url }}');"></div>
      {%- endif -%}
      <div class="hero-clouds__glow"></div>
    </div>
    {%- if section.settings.clouds_cup_url != blank -%}
      <img
        class="hero-clouds__cup"
        src="{{ section.settings.clouds_cup_url }}"
        alt=""
        aria-hidden="true"
        loading="eager"
        width="600"
        height="600"
      >
    {%- endif -%}
  {%- endif -%}

  <div class="hero-banner-container section--page-width section">
    <div class="hero-banner-content">

      {%- if section.settings.show_image and section.settings.image != blank -%}
        <div class="hero-banner-image">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt }}"
            loading="lazy"
            width="auto"
            height="auto"
          >
        </div>
      {%- endif -%}

      <div class="hero-banner-text">
        {% content_for 'blocks' %}
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
.hero-banner-section {
  background-image: var(--hero-bg-image, none);
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  width: 100%;
  height: var(--hero-height, auto);
  min-height: var(--hero-min-height, 700px);
  display: flex;
  align-items: center;
}

.hero-banner-content {
  display: flex;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
}

.hero-banner-image {
  flex: 0 0 auto;
  max-width: 400px;
}

.hero-banner-text {
  flex: 1;
  min-width: 300px;
  display: flex;
  flex-direction: column;
}

@media screen and (max-width: 768px) {
  .hero-banner-section {
    padding: 40px 15px;
    height: var(--hero-height-mobile, auto);
    min-height: var(--hero-min-height-mobile, 400px);
    background-image: var(--hero-bg-image-mobile, var(--hero-bg-image, none));
  }

  .hero-banner-content {
    flex-direction: column;
    gap: 30px;
  }

  .hero-banner-image {
    max-width: 300px;
  }
}

/* Efecto de nubes en capas: cielo animado + degradado en movimiento + helado al frente */
.hero-banner-section--clouds {
  position: relative;
  overflow: hidden;
}

/* Capa 0 — cielo con nubes, deriva lenta */
.hero-clouds {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
}

.hero-clouds__sky {
  position: absolute;
  inset: -8%;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  animation: hope-sky-drift 42s ease-in-out infinite alternate;
  will-change: transform;
}

/* Capa 1 — degradado que se desliza sobre el cielo (detrás del helado) */
.hero-clouds__glow {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.55) 25%,
    rgba(255, 255, 255, 0) 50%,
    rgba(255, 255, 255, 0.45) 75%,
    rgba(255, 255, 255, 0) 100%
  );
  background-size: 220% 100%;
  mix-blend-mode: screen;
  animation: hope-sky-glow 16s ease-in-out infinite alternate;
  will-change: background-position;
}

/* Capa 2 — helado (PNG transparente), fijo */
.hero-clouds__cup {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: var(--cloud-cup-size, 30%);
  max-width: 520px;
  height: auto;
  z-index: 1;
  pointer-events: none;
  filter: drop-shadow(0 12px 24px rgba(99, 0, 34, 0.18));
}

.hero-banner-section--clouds[data-cup-align="left"] .hero-clouds__cup {
  left: 4%;
  transform: none;
}

.hero-banner-section--clouds[data-cup-align="right"] .hero-clouds__cup {
  left: auto;
  right: 4%;
  transform: none;
}

/* Capa 3 — contenido (textos/botón) por encima de todo */
.hero-banner-section--clouds .hero-banner-container {
  position: relative;
  z-index: 2;
}

@keyframes hope-sky-drift {
  from {
    transform: translate3d(-2%, -1%, 0) scale(1.08);
  }
  to {
    transform: translate3d(2%, 1%, 0) scale(1.08);
  }
}

@keyframes hope-sky-glow {
  from {
    background-position: 0% 50%;
  }
  to {
    background-position: 100% 50%;
  }
}

@media screen and (max-width: 768px) {
  .hero-clouds__cup {
    width: var(--cloud-cup-size-mobile, 58%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-clouds__sky,
  .hero-clouds__glow {
    animation: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner Helados",
  "blocks": [
    { 
      "type": "_hero-text-row" 
    },
    { 
      "type": "_hero-button" 
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Altura de la Sección"
    },
    {
      "type": "select",
      "id": "height_type",
      "label": "Tipo de Altura",
      "options": [
        { "value": "auto", "label": "Automática (según contenido)" },
        { "value": "full", "label": "Pantalla completa (100vh)" },
        { "value": "custom", "label": "Personalizada" }
      ],
      "default": "auto",
      "info": "Elige cómo se calcula la altura de la sección"
    },
    {
      "type": "header",
      "content": "Altura Automática — Mínimo"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Altura Mínima (Escritorio)",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 700,
      "info": "Solo aplica cuando el tipo de altura es 'Automática'"
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Altura Mínima (Mobile)",
      "min": 150,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 400,
      "info": "Solo aplica cuando el tipo de altura es 'Automática'"
    },
    {
      "type": "header",
      "content": "Altura Personalizada"
    },
    {
      "type": "range",
      "id": "height_custom",
      "label": "Altura Personalizada (Escritorio)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 80,
      "info": "Solo aplica cuando el tipo de altura es 'Personalizada'. La unidad se elige abajo."
    },
    {
      "type": "select",
      "id": "height_unit",
      "label": "Unidad (Escritorio)",
      "options": [
        { "value": "vh", "label": "vh (% de la pantalla)" },
        { "value": "rem", "label": "rem" },
        { "value": "px", "label": "px" }
      ],
      "default": "vh"
    },
    {
      "type": "range",
      "id": "height_custom_mobile",
      "label": "Altura Personalizada (Mobile)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 60,
      "info": "Solo aplica cuando el tipo de altura es 'Personalizada'. La unidad se elige abajo."
    },
    {
      "type": "select",
      "id": "height_unit_mobile",
      "label": "Unidad (Mobile)",
      "options": [
        { "value": "vh", "label": "vh (% de la pantalla)" },
        { "value": "rem", "label": "rem" },
        { "value": "px", "label": "px" }
      ],
      "default": "vh"
