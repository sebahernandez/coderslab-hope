{%- comment -%}
  Vitrina de colección: grid de tarjetas propias + filtro por categoría (chips) con
  filtrado client-side instantáneo (sin recarga). Pensada para catálogos pequeños.

  Convención del tema: los valores dinámicos viajan como CSS vars inline; el CSS estático
  vive en assets/collection-showcase.css. El filtro compara el `data-filter` del chip contra
  el `data-tags` de cada tarjeta (ambos en minúscula), por lo que `match_tag` debe coincidir
  con un tag real del producto.
{%- endcomment -%}

{{ 'collection-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-showcase.js' | asset_url }}" type="module"></script>

{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '3 / 4'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = 'auto'
  endcase
-%}

{%- comment -%} Sin .section-background: la sección es transparente para dejar ver el fondo rosa de la página (body). {%- endcomment -%}
<collection-showcase
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style gap-style collection-showcase"
  data-section-id="{{ section.id }}"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    {%- render 'gap-style', value: section.settings.gap -%}
    --cs-columns: {{ section.settings.columns }};
    --cs-columns-mobile: {{ section.settings.mobile_columns }};
    --cs-grid-gap: {{ section.settings.grid_gap }}px;
    --cs-ratio: {{ ratio }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="cs-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- liquid
    assign has_chips = false
    if section.settings.show_all_chip or section.blocks.size > 0
      assign has_chips = true
    endif
  -%}
  {%- if has_chips -%}
    <div class="cs-filters" role="group" aria-label="Filtrar productos">
      {%- if section.settings.show_all_chip -%}
        <button type="button" class="cs-chip is-active" data-filter="*" aria-pressed="true">
          {{ section.settings.all_chip_label | default: 'Todos' }}
        </button>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign chip_active = false
          if section.settings.show_all_chip == false and forloop.first
            assign chip_active = true
          endif
        -%}
        <button
          type="button"
          class="cs-chip{% if chip_active %} is-active{% endif %}"
          data-filter="{{ block.settings.match_tag | downcase | strip }}"
          aria-pressed="{% if chip_active %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.chip_label }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <ul class="cs-grid" role="list">
        {%- for product in collection.products -%}
          {%- unless product.tags contains 'addon' -%}
            <li
              class="cs-card card-hover-effect-subtle-zoom"
              data-tags="{{ product.tags | join: ',' | downcase }}"
            >
              <a href="{{ product.url }}" class="cs-card__link">
                <div class="cs-card__media">
                  {%- if product.featured_media -%}
                    {{
                      product.featured_media
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 750px) 33vw, 100vw',
                        widths: '300, 400, 500, 700, 900',
                        class: 'cs-card__image',
                        alt: product.featured_media.alt | default: product.title
                    }}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'cs-card__image cs-card__image--placeholder' }}
                  {%- endif -%}
                </div>
                <h3 class="cs-card__title">{{ product.title }}</h3>
                {%- render 'price', product_resource: product -%}
                <span class="cs-card__cta button">{{ section.settings.cta_label | default: 'Ver producto' }}</span>
              </a>
            </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- comment -%} Estado onboarding / colección vacía {%- endcomment -%}
      <ul class="cs-grid" role="list">
        {%- for i in (1..3) -%}
          <li class="cs-card cs-card--placeholder">
            <div class="cs-card__media">
              {{ 'product-apparel-' | append: i | placeholder_svg_tag: 'cs-card__image cs-card__image--placeholder' }}
            </div>
            <h3 class="cs-card__title">{{ 'Producto de ejemplo' }}</h3>
            <span class="cs-card__cta button">{{ section.settings.cta_label | default: 'Ver producto' }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  {%- endpaginate -%}
</collection-showcase>

{% schema %}
{
  "name": "Vitrina de colección",
  "tag": "section",
  "class": "section-collection-showcase",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título de la sección",
      "default": "Nuestros productos"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón de la tarjeta",
      "default": "Personalizar"
    },
    {
      "type": "header",
      "content": "Filtro por categoría",
      "info": "Cada categoría se agrega como bloque. El campo 'Tag a coincidir' debe ser igual a un tag del producto (en el admin) para que el filtro funcione."
    },
    {
      "type": "checkbox",
      "id": "show_all_chip",
      "label": "Mostrar chip 'Todos'",
      "default": true
    },
    {
      "type": "text",
      "id": "all_chip_label",
      "label": "Texto del chip 'Todos'",
      "default": "Todos"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas (escritorio)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columnas (móvil)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Espacio entre tarjetas",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de imagen",
      "options": [
        { "value": "square", "label": "Cuadrada (1:1)" },
        { "value": "portrait", "label": "Retrato (3:4)" },
        { "value": "landscape", "label": "Paisaje (4:3)" },
        { "value": "natural", "label": "Natural" }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Diseño de la sección"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio vertical interno",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "cs-chip",
      "name": "Categoría",
      "settings": [
        {
          "type": "text",
          "id": "chip_label",
          "label": "Nombre visible",
          "default": "Categoría"
        },
        {
          "type": "text",
          "id": "match_tag",
          "label": "Tag a coincidir",
          "info": "Debe ser igual a un tag del producto (ej: helados). Sin distinción de mayúsculas."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Vitrina de colección",
      "category": "Colección",
      "settings": {
        "heading": "Nuestros productos",
        "cta_label": "Personalizar",
        "show_all_chip": true,
        "all_chip_label": "Todos",
        "columns": 3,
        "mobile_columns": "1",
        "grid_gap": 24,
        "image_ratio": "portrait",
        "section_width": "page-width",
        "gap": 32,
        "color_scheme": "scheme-1",
        "padding-block-start": 140,
        "padding-block-end": 48
      },
      "blocks": [
        { "type": "cs-chip", "settings": { "chip_label": "Helados", "match_tag": "helados" } },
        { "type": "cs-chip", "settings": { "chip_label": "Milkshakes", "match_tag": "milkshake" } },
        { "type": "cs-chip", "settings": { "chip_label": "Delivery", "match_tag": "delivery" } }
      ]
    }
  ]
}
{% endschema %}
