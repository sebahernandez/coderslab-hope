{% comment %}
  Section contract.
  Renders a two-column banner: a stack of text blocks (heading, subheading, text, button)
  next to an image. Each block owns its copy, colors, sizes and spacing. The section owns
  the image (independent desktop/mobile images, aspect ratio, size per breakpoint, horizontal alignment of the frame and of a
  contained image within it, including an outer-edge option that follows the image side,
  focal position, radius) and
  the layout: image side on desktop, image order on mobile, column width, gap, vertical
  alignment and text alignment per breakpoint. Columns stack below 750px.
  @example
  <!-- Add "Texto con imagen" from the theme editor and edit its blocks -->
{% endcomment %}

{% liquid
  assign s = section.settings
  assign image_desktop = s.image_desktop | default: s.image_mobile
  assign image_mobile = s.image_mobile | default: s.image_desktop

  # Aspect ratio: 'auto' follows the uploaded image; otherwise the numeric value is used.
  # With 'auto' the frame matches the image, so 'contain' guarantees a full, uncropped image.
  assign ratio_desktop = s.ratio_desktop
  assign fit_desktop = s.image_fit
  if ratio_desktop == 'auto'
    assign ratio_desktop = image_desktop.aspect_ratio | default: 1.25
    assign fit_desktop = 'contain'
  endif
  assign ratio_mobile = s.ratio_mobile
  assign fit_mobile = s.image_fit
  if ratio_mobile == 'auto'
    assign ratio_mobile = image_mobile.aspect_ratio | default: ratio_desktop
    assign fit_mobile = 'contain'
  endif

  # Horizontal alignment drives the reduced frame and the contained image inside it.
  # 'edge' follows the desktop image side and falls back to center once columns stack.
  case s.image_align
    when 'start'
      assign image_justify = 'flex-start'
      assign image_justify_mobile = 'flex-start'
    when 'end'
      assign image_justify = 'flex-end'
      assign image_justify_mobile = 'flex-end'
    when 'edge'
      assign image_justify = 'flex-start'
      if s.media_side == 'end'
        assign image_justify = 'flex-end'
      endif
      assign image_justify_mobile = 'center'
    else
      assign image_justify = 'center'
      assign image_justify_mobile = 'center'
  endcase

  # Vertical placement of a contained image within its frame.
  case s.image_position
    when 'top'
      assign image_items = 'flex-start'
    when 'bottom'
      assign image_items = 'flex-end'
    else
      assign image_items = 'center'
  endcase

  # Contained images are sized inside the frame (not object-fit) so the radius follows the visible image.
  # An image narrower than its frame fills the height; otherwise it fills the width.
  assign frame_class = 'text-image__frame'
  if image_desktop != blank
    if fit_desktop == 'contain'
      assign frame_class = frame_class | append: ' text-image__frame--contain-desktop'
      assign frame_ratio = ratio_desktop | times: 1.0
      if image_desktop.aspect_ratio < frame_ratio
        assign frame_class = frame_class | append: ' text-image__frame--by-height-desktop'
      endif
    endif
    if fit_mobile == 'contain'
      assign frame_class = frame_class | append: ' text-image__frame--contain-mobile'
      assign frame_ratio = ratio_mobile | times: 1.0
      if image_mobile.aspect_ratio < frame_ratio
        assign frame_class = frame_class | append: ' text-image__frame--by-height-mobile'
      endif
    endif
  endif

  assign position_desktop = s.image_position
  if position_desktop == 'auto'
    assign position_desktop = image_desktop.presentation.focal_point | default: 'center'
  endif
  assign position_mobile = s.image_position
  if position_mobile == 'auto'
    assign position_mobile = image_mobile.presentation.focal_point | default: 'center'
  endif

  assign alt = s.image_alt | default: image_desktop.alt | escape

  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  # Effective rendered width: column width scaled by the image size setting.
  assign image_scale = s.image_scale | default: 100
  assign image_scale_mobile = s.image_scale_mobile | default: 100
  assign media_vw = s.media_width | times: image_scale | divided_by: 100
  assign sizes_mobile = image_scale_mobile | append: 'vw'
  if s.layout_width == 'full'
    assign sizes = '(min-width: 750px) ' | append: media_vw | append: 'vw, ' | append: sizes_mobile
  else
    assign sizes_px = 1600 | times: media_vw | divided_by: 100
    assign sizes = '(min-width: 1600px) ' | append: sizes_px | append: 'px, (min-width: 750px) ' | append: media_vw | append: 'vw, ' | append: sizes_mobile
  endif

  case s.text_align_desktop
    when 'center'
      assign items_desktop = 'center'
    when 'right'
      assign items_desktop = 'flex-end'
    else
      assign items_desktop = 'flex-start'
  endcase
  case s.text_align_mobile
    when 'center'
      assign items_mobile = 'center'
    when 'right'
      assign items_mobile = 'flex-end'
    else
      assign items_mobile = 'flex-start'
  endcase
%}

<div
  class="text-image color-{{ s.color_scheme }} text-image--media-{{ s.media_side }} text-image--mobile-media-{{ s.mobile_media_order }}"
  style="
    --ti-pad-top: {{ s.padding_top }}px;
    --ti-pad-bottom: {{ s.padding_bottom }}px;
    --ti-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --ti-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --ti-gap: {{ s.gap }}px;
    --ti-gap-mobile: {{ s.gap_mobile }}px;
    --ti-media-width: {{ s.media_width }}%;
    --ti-content-max: {{ s.content_max_width }}px;
    --ti-align-v: {{ s.vertical_align }};
    --ti-text-align: {{ s.text_align_desktop }};
    --ti-text-align-mobile: {{ s.text_align_mobile }};
    --ti-items: {{ items_desktop }};
    --ti-items-mobile: {{ items_mobile }};
    --ti-ratio: {{ ratio_desktop }};
    --ti-ratio-mobile: {{ ratio_mobile }};
    --ti-position: {{ position_desktop }};
    --ti-position-mobile: {{ position_mobile }};
    --ti-radius: {{ s.image_radius }}px;
    --ti-fit: {{ fit_desktop }};
    --ti-fit-mobile: {{ fit_mobile }};
    --ti-scale: {{ image_scale }}%;
    --ti-scale-mobile: {{ image_scale_mobile }}%;
    --ti-image-justify: {{ image_justify }};
    --ti-image-justify-mobile: {{ image_justify_mobile }};
    --ti-image-items: {{ image_items }};
  "
>
  <div class="text-image__inner text-image__inner--{{ s.layout_width }}">
    <div class="text-image__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              {%- assign tag = block.settings.tag -%}
              <{{ tag }}
                class="text-image__heading"
                style="--ti-size: {{ block.settings.size }}px; --ti-size-mobile: {{ block.settings.size_mobile }}px; --ti-weight: {{ block.settings.weight }}; --ti-line: {{ block.settings.line_height | divided_by: 100.0 }}; --ti-space: {{ block.settings.spacing_bottom }}px;{% if block.settings.color != blank %} --ti-color: {{ block.settings.color }};{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.heading -}}
              </{{ tag }}>
            {%- endif -%}

          {%- when 'subheading' -%}
            {%- if block.settings.text != blank -%}
              <p
                class="text-image__subheading{% if block.settings.uppercase %} text-image__subheading--upper{% endif %}"
                style="--ti-size: {{ block.settings.size }}px; --ti-size-mobile: {{ block.settings.size_mobile }}px; --ti-weight: {{ block.settings.weight }}; --ti-tracking: {{ block.settings.letter_spacing | divided_by: 100.0 }}em; --ti-space: {{ block.settings.spacing_bottom }}px;{% if block.settings.color != blank %} --ti-color: {{ block.settings.color }};{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </p>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div
                class="text-image__text"
                style="--ti-size: {{ block.settings.size }}px; --ti-size-mobile: {{ block.settings.size_mobile }}px; --ti-max: {{ block.settings.max_width }}ch; --ti-space: {{ block.settings.spacing_bottom }}px;{% if block.settings.color != blank %} --ti-color: {{ block.settings.color }};{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </div>
            {%- endif -%}

          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <div
                class="text-image__actions"
                style="--ti-space: {{ block.settings.spacing_bottom }}px;"
                {{ block.shopify_attributes }}
              >
                <a
                  class="text-image__button text-image__button--{{ block.settings.style }} text-image__button--{{ block.settings.size }}{% if block.settings.full_width_mobile %} text-image__button--full-mobile{% endif %}"
                  {% if block.settings.link != blank %}
                    href="{{ block.settings.link }}"
                  {% else %}
                    role="link"
                    aria-disabled="true"
                  {% endif %}
                  {% if block.settings.new_tab %}
                    target="_blank" rel="noopener"
                  {% endif %}
                  style="--ti-btn-bg: {{ block.settings.background | default: 'var(--color-foreground)' }}; --ti-btn-fg: {{ block.settings.text_color | default: 'var(--color-background)' }}; --ti-btn-bg-hover: {{ block.settings.background_hover | default: block.settings.background | default: 'var(--color-foreground)' }}; --ti-btn-radius: {{ block.settings.radius }}px;"
                >
                  <span>{{ block.settings.label | escape }}</span>
                  {%- if block.settings.show_arrow -%}
                    <span class="text-image__button-icon" aria-hidden="true">
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </span>
                  {%- endif -%}
                </a>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="text-image__media">
      {%- if s.image_link != blank -%}
        <a class="{{ frame_class }}" href="{{ s.image_link }}">
      {%- else -%}
        <div class="{{ frame_class }}">
      {%- endif -%}

      {%- if image_desktop != blank -%}
        <picture class="text-image__picture">
          {%- if s.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ image_mobile | image_url: width: 375 }} 375w, {{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1125 }} 1125w, {{ image_mobile | image_url: width: 1500 }} 1500w"
              sizes="{{ sizes_mobile }}"
              width="{{ image_mobile.width }}"
              height="{{ image_mobile.height }}"
            >
          {%- endif -%}
          {{
            image_desktop
            | image_url: width: 2400
            | image_tag:
              widths: '600, 800, 1000, 1200, 1600, 2000, 2400',
              sizes: sizes,
              alt: alt,
              loading: loading,
              fetchpriority: fetchpriority,
              class: 'text-image__image'
          }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'text-image__image text-image__placeholder' }}
      {%- endif -%}

      {%- if s.image_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .text-image {
    padding-block: var(--ti-pad-top) var(--ti-pad-bottom);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .text-image__inner {
    box-sizing: border-box;
    display: flex;
    align-items: var(--ti-align-v, center);
    gap: var(--ti-gap);
    width: 100%;
    margin-inline: auto;
  }

  .text-image__inner--page {
    max-width: var(--page-width);
    padding-inline: var(--page-margin);
  }

  .text-image__inner--full {
    padding-inline: var(--page-margin);
  }

  .text-image--media-start .text-image__media {
    order: -1;
  }

  .text-image__content {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: var(--ti-items);
    min-width: 0;
    max-width: var(--ti-content-max);
    text-align: var(--ti-text-align);
    overflow-wrap: break-word;
  }

  .text-image--media-end .text-image__content {
    margin-inline-end: auto;
  }

  .text-image--media-start .text-image__content {
    margin-inline-start: auto;
  }

  .text-image__content > * {
    margin-block: 0 var(--ti-space, 0);
  }

  .text-image__content > *:last-child {
    margin-block-end: 0;
  }

  .text-image__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--ti-weight, 700);
    font-size: var(--ti-size);
    line-height: var(--ti-line, 1.05);
    letter-spacing: -0.01em;
    color: var(--ti-color, var(--color-foreground-heading, var(--color-foreground)));
    text-wrap: balance;
  }

  .text-image__subheading {
    font-family: var(--font-body--family);
    font-weight: var(--ti-weight, 600);
    font-size: var(--ti-size);
    letter-spacing: var(--ti-tracking, 0);
    line-height: 1.4;
    color: var(--ti-color, var(--color-foreground));
  }

  .text-image__subheading--upper {
    text-transform: uppercase;
  }

  .text-image__text {
    max-width: var(--ti-max, 60ch);
    font-family: var(--font-body--family);
    font-size: var(--ti-size);
    line-height: 1.5;
    color: var(--ti-color, var(--color-foreground));
  }

  .text-image__text > * {
    margin: 0;
  }

  .text-image__text > * + * {
    margin-block-start: 0.75em;
  }

  .text-image__actions {
    display: flex;
    max-width: 100%;
  }

  .text-image__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 44px;
    border: 2px solid var(--ti-btn-bg);
    border-radius: var(--ti-btn-radius, 999px);
    font-family: var(--font-body--family);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .text-image__button--small {
    padding: 0.5em 1.1em;
    font-size: 0.8125rem;
  }

  .text-image__button--medium {
    padding: 0.7em 1.4em;
    font-size: 0.9375rem;
  }

  .text-image__button--large {
    padding: 0.9em 1.8em;
    font-size: 1.0625rem;
  }

  .text-image__button--solid {
    background-color: var(--ti-btn-bg);
    color: var(--ti-btn-fg);
  }

  .text-image__button--solid:hover {
    background-color: var(--ti-btn-bg-hover);
    border-color: var(--ti-btn-bg-hover);
  }

  .text-image__button--outline {
    background-color: transparent;
    color: var(--ti-btn-bg);
  }

  .text-image__button--outline:hover {
    background-color: var(--ti-btn-bg);
    color: var(--ti-btn-fg);
  }

  .text-image__button:hover {
    transform: translateY(-1px);
  }

  .text-image__button:focus-visible,
  .text-image__frame:focus-visible {
    outline: var(--focus-outline-width, 2px) solid currentColor;
    outline-offset: var(--focus-outline-offset, 3px);
  }

  .text-image__button-icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
    transition: transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .text-image__button-icon svg {
    width: 100%;
    height: 100%;
  }

  .text-image__button:hover .text-image__button-icon {
    transform: translateX(3px);
  }

  [dir='rtl'] .text-image__button-icon svg {
    transform: scaleX(-1);
  }

  [dir='rtl'] .text-image__button:hover .text-image__button-icon {
    transform: translateX(-3px);
  }

  .text-image__media {
    display: flex;
    flex: 0 0 var(--ti-media-width);
    justify-content: var(--ti-image-justify, center);
    min-width: 0;
  }

  .text-image__frame {
    display: block;
    width: var(--ti-scale, 100%);
    overflow: hidden;
    aspect-ratio: var(--ti-ratio);
    border-radius: var(--ti-radius);
  }

  .text-image__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .text-image__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: var(--ti-fit, cover);
    object-position: var(--ti-position, center);
  }

  .text-image__placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5, 0.05));
  }

  @media screen and (min-width: 750px) {
    .text-image__frame--contain-desktop {
      display: flex;
      align-items: var(--ti-image-items, center);
      justify-content: var(--ti-image-justify, center);
      overflow: visible;
      border-radius: 0;
    }

    .text-image__frame--contain-desktop .text-image__picture {
      display: contents;
    }

    .text-image__frame--contain-desktop .text-image__image {
      width: 100%;
      height: auto;
      object-fit: fill;
      border-radius: var(--ti-radius);
    }

    .text-image__frame--by-height-desktop .text-image__image {
      width: auto;
      height: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-image__button,
    .text-image__button-icon {
      transition: none;
    }

    .text-image__button:hover,
    .text-image__button:hover .text-image__button-icon {
      transform: none;
    }
  }

  @media screen and (max-width: 749px) {
    .text-image {
      padding-block: var(--ti-pad-top-mobile) var(--ti-pad-bottom-mobile);
    }

    .text-image__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--ti-gap-mobile);
    }

    .text-image--mobile-media-first .text-image__media {
      order: -1;
    }

    .text-image--mobile-media-last .text-image__media {
      order: 1;
    }

    .text-image__content {
      flex: 0 1 auto;
      max-width: none;
      margin-inline: 0;
      align-items: var(--ti-items-mobile);
      text-align: var(--ti-text-align-mobile);
    }

    .text-image__heading,
    .text-image__subheading,
    .text-image__text {
      font-size: var(--ti-size-mobile);
    }

    .text-image__media {
      flex: 0 0 auto;
      width: 100%;
      justify-content: var(--ti-image-justify-mobile, center);
    }

    .text-image__frame {
      width: var(--ti-scale-mobile, 100%);
      aspect-ratio: var(--ti-ratio-mobile);
    }

    .text-image__image {
      object-fit: var(--ti-fit-mobile, cover);
      object-position: var(--ti-position-mobile, center);
    }

    .text-image__frame--contain-mobile {
      display: flex;
      align-items: var(--ti-image-items, center);
      justify-content: var(--ti-image-justify-mobile, center);
      overflow: visible;
      border-radius: 0;
    }

    .text-image__frame--contain-mobile .text-image__picture {
      display: contents;
    }

    .text-image__frame--contain-mobile .text-image__image {
      width: 100%;
      height: auto;
      object-fit: fill;
      border-radius: var(--ti-radius);
    }

    .text-image__frame--by-height-mobile .text-image__image {
      width: auto;
      height: 100%;
    }

    .text-image__actions:has(.text-image__button--full-mobile) {
      width: 100%;
    }

    .text-image__button--full-mobile {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Texto con imagen",
  "tag": "section",
  "class": "text-image-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen escritorio"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen móvil",
      "info": "Opcional. Se muestra en pantallas de 749 px o menos; si está vacía se usa la de escritorio."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo",
      "info": "Si está vacío se usa el texto alternativo de la imagen."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Enlace de la imagen"
    },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "Proporción escritorio",
      "options": [
        { "value": "auto", "label": "Según la imagen" },
        { "value": "1", "label": "Cuadrada (1:1)" },
        { "value": "1.25", "label": "Horizontal (5:4)" },
        { "value": "1.333", "label": "Horizontal (4:3)" },
        { "value": "1.5", "label": "Horizontal (3:2)" },
        { "value": "1.778", "label": "Panorámica (16:9)" },
        { "value": "0.8", "label": "Vertical (4:5)" },
        { "value": "0.75", "label": "Vertical (3:4)" }
      ],
      "default": "1.25"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Proporción móvil",
      "options": [
        { "value": "auto", "label": "Según la imagen" },
        { "value": "1", "label": "Cuadrada (1:1)" },
        { "value": "1.25", "label": "Horizontal (5:4)" },
        { "value": "1.333", "label": "Horizontal (4:3)" },
        { "value": "1.5", "label": "Horizontal (3:2)" },
        { "value": "1.778", "label": "Panorámica (16:9)" },
        { "value": "0.8", "label": "Vertical (4:5)" },
        { "value": "0.75", "label": "Vertical (3:4)" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Encaje",
      "options": [
        { "value": "cover", "label": "Cubrir" },
        { "value": "contain", "label": "Contener" }
      ],
      "default": "cover",
      "info": "Con la proporción \"Según la imagen\" la imagen siempre se ve completa, sin recorte."
    },
    {
      "type": "range",
      "id": "image_scale",
      "label": "Tamaño de la imagen (escritorio)",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "info": "Achica la imagen dentro de su columna manteniendo la proporción, sin mover el texto."
    },
    {
      "type": "range",
      "id": "image_scale_mobile",
      "label": "Tamaño de la imagen (móvil)",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_align",
      "label": "Alineación horizontal de la imagen",
      "options": [
        { "value": "start", "label": "Inicio" },
        { "value": "center", "label": "Centro" },
