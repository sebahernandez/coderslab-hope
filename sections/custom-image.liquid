      ]
    },
    {
      "type": "color",
      "id": "fallback_color",
      "label": "Fallback Background Color",
      "default": "#f0f0f0"
    },
    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "checkbox",
      "id": "overlay_enable",
      "label": "Enable Overlay",
      "default": false
    },
    {
      "type": "color",
