        },
        {
          "value": "40vh",
          "label": "Medium (40vh)"
        },
        {
          "value": "50vh",
          "label": "Large (50vh)"
        },
        {
          "value": "60vh",
          "label": "Extra Large (60vh)"
        },
        {
          "value": "100vh",
          "label": "Full Screen (100vh)"
        },
        {
          "value": "300px",
          "label": "300px"
        },
        {
          "value": "400px",
          "label": "400px"
        },
        {
          "value": "500px",
          "label": "500px"
        },
        {
          "value": "550px",
          "label": "550px"
