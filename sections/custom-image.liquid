          "value": "100vh",
          "label": "Full Screen (100vh)"
        },
        {
          "value": "400px",
          "label": "400px"
        },
        {
          "value": "500px",
          "label": "500px"
        },
        {
          "value": "600px",
          "label": "600px"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_height_mobile",
      "label": "Mobile Height",
      "default": "50vh",
      "options": [
        {
          "value": "30vh",
