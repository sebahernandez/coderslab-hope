{%- comment -%}
  Section: custom-product-helado.liquid
  Tema: Horizon
  Uso: configurador visual "Crea tu Hope" (helado / yogurt / milkshake).

  Puerto del prototipo 2D (intercambio de imágenes Cloudinary) a Liquid/Shopify.
  - Los 3 modos (tabs) conviven en la misma sección.
  - Cada modo puede apuntar a un producto real de Shopify (settings) para el
    carrito. El tamaño (helado) / sabor (milkshake) se resuelve a una variante.
  - Los toppings y siropes viajan como line item properties (son gratuitos).

  Los assets toppings-customizer.css/js se cargan globalmente en layout/theme.liquid,
  por eso aquí NO se vuelven a incluir (evita doble ejecución del JS).
{%- endcomment -%}

{%- liquid
  assign p_helado = section.settings.producto_helado | default: closest.product | default: product
  assign p_yogurt = section.settings.producto_yogurt
  assign p_milkshake = section.settings.producto_milkshake

  comment
    Extras (toppings/siropes) desde el metafield del producto configurado.
    Cada item mapea a un producto add-on por handle para resolver precio real.
  endcomment
  assign cfg_product = p_helado
  assign cfg_cats = cfg_product.metafields.custom.opciones_customizador.value.categorias
  assign cat_sirope = cfg_cats | where: 'nombre', 'Sirope' | first

  comment
    Los toppings pueden venir en varias categorías (todo lo que no sea "Sirope").
    Contamos si hay al menos un item para decidir metafield vs fallback.
  endcomment
  assign meta_topping_count = 0
  if cfg_cats
    for c in cfg_cats
      unless c.nombre == 'Sirope'
        assign meta_topping_count = meta_topping_count | plus: c.items.size
      endunless
    endfor
  endif
-%}

{%- comment -%} Datos de variantes por modo, consumidos por el JS para el carrito real {%- endcomment -%}
{%- capture products_json -%}
{
  {%- if p_helado -%}
  "helado": {
    "id": {{ p_helado.id }},
    "handle": {{ p_helado.handle | json }},
    "variants": [
      {%- for v in p_helado.variants -%}
        {"id": {{ v.id }}, "option1": {{ v.option1 | json }}, "option2": {{ v.option2 | json }}, "price": {{ v.price }}, "price_formatted": {{ v.price | money | strip_html | json }}, "available": {{ v.available }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }{%- if p_yogurt or p_milkshake -%},{%- endif -%}
  {%- endif -%}
  {%- if p_yogurt -%}
  "yogurt": {
    "id": {{ p_yogurt.id }},
    "handle": {{ p_yogurt.handle | json }},
    "variants": [
      {%- for v in p_yogurt.variants -%}
        {"id": {{ v.id }}, "option1": {{ v.option1 | json }}, "option2": {{ v.option2 | json }}, "price": {{ v.price }}, "price_formatted": {{ v.price | money | strip_html | json }}, "available": {{ v.available }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }{%- if p_milkshake -%},{%- endif -%}
  {%- endif -%}
  {%- if p_milkshake -%}
  "milkshake": {
    "id": {{ p_milkshake.id }},
    "handle": {{ p_milkshake.handle | json }},
    "variants": [
      {%- for v in p_milkshake.variants -%}
        {"id": {{ v.id }}, "option1": {{ v.option1 | json }}, "option2": {{ v.option2 | json }}, "price": {{ v.price }}, "price_formatted": {{ v.price | money | strip_html | json }}, "available": {{ v.available }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  {%- endif -%}
}
{%- endcapture -%}

<div
  class="hopecfg"
  data-hopecfg
  data-modo="{{ section.settings.modo | default: 'helado' }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-cloudinary-account="{{ section.settings.cloudinary_account | default: 'slealu5f' | escape }}"
  data-cloudinary-folder="{{ section.settings.cloudinary_folder | default: 'hope/catalog' | escape }}"
>
  <script type="application/json" data-hopecfg-products>{{ products_json }}</script>

  <div class="hopecfg__frame">
    {%- comment -%} ===== Panel de vista previa ===== {%- endcomment -%}
    <section class="hopecfg__preview" id="preview-panel" data-view="2d">
      {%- if section.settings.logo != blank -%}
        <div class="hopecfg__brand" id="brand-badge">
          <img
            id="brand-logo"
            class="hopecfg__brand-logo"
            src="{{ section.settings.logo | image_url: width: 320 }}"
            alt="{{ shop.name | escape }}"
            width="160"
            loading="eager"
          >
        </div>
      {%- endif -%}

      {%- if section.settings.mostrar_tabs -%}
        <div class="hopecfg__tabs" role="tablist" aria-label="Seleccionar presentación">
          <button class="hopecfg__tab is-active" data-preview="2d" type="button" role="tab" aria-selected="true">
            {{ section.settings.tab_helado | default: 'HELADO' }}
          </button>
          <button class="hopecfg__tab" data-preview="yogurt" type="button" role="tab" aria-selected="false">
            {{ section.settings.tab_yogurt | default: 'YOGURTS' }}
          </button>
          <button class="hopecfg__tab" data-preview="milkshake" type="button" role="tab" aria-selected="false">
            {{ section.settings.tab_milkshake | default: 'MILKSHAKES' }}
          </button>
        </div>
      {%- endif -%}

      <div class="hopecfg__stage">
        <img
          id="product-preview"
          class="hopecfg__cup"
          data-mode="2d"
          src=""
          alt="{{ shop.name | escape }}"
          decoding="async"
        >
      </div>

      <div class="hopecfg__extras" id="extras-panel">
        <div class="hopecfg__extras-inner">
          <div id="selected-stack-left" class="hopecfg__stack"></div>
          <p id="extras-label-left" class="hopecfg__extras-label">Sin extras</p>
        </div>
      </div>
    </section>

    {%- comment -%} ===== Panel de configuración ===== {%- endcomment -%}
    <section class="hopecfg__config" id="config-panel" data-view="2d">
      <div class="hopecfg__config-scroll">
        <div class="hopecfg__heading">
          <p id="eyebrow" class="hopecfg__eyebrow">{{ section.settings.eyebrow | default: 'Helado de yogurt griego' }}</p>
          <h2 id="page-title" class="hopecfg__title">{{ section.settings.titulo | default: 'Crea tu helado Hope' }}</h2>
        </div>

        {%- comment -%} Opciones para helado (2d) y yogurt (mixo) {%- endcomment -%}
        <div id="yogurt-options" class="hopecfg__groups">
          <fieldset id="size-options" class="hopecfg__group" data-group="size">
            <legend class="hopecfg__legend">1 · Elige tu tamaño</legend>
            <div class="hopecfg__grid hopecfg__grid--3">
              <button class="hopecfg__choice hopecfg__choice--size is-active" data-id="small" type="button">
                <span class="hopecfg__check"></span>
                <span class="hopecfg__choice-name">Pequeño</span>
                <span class="hopecfg__choice-sub" data-size-price>4 oz</span>
              </button>
              <button class="hopecfg__choice hopecfg__choice--size" data-id="medium" type="button">
                <span class="hopecfg__check"></span>
                <span class="hopecfg__choice-name">Mediano</span>
                <span class="hopecfg__choice-sub" data-size-price>8 oz</span>
              </button>
              <button class="hopecfg__choice hopecfg__choice--size" data-id="large" type="button">
                <span class="hopecfg__check"></span>
                <span class="hopecfg__choice-name">Grande</span>
                <span class="hopecfg__choice-sub" data-size-price>12 oz</span>
              </button>
            </div>
          </fieldset>

          {%- comment -%} Toppings normales: obligatorio elegir 2 (incluidos en el precio) {%- endcomment -%}
          <fieldset id="topping-options" class="hopecfg__group" data-group="topping">
            <legend class="hopecfg__legend">
              <span id="topping-title">2 · Elige 2 toppings</span>
              <span class="hopecfg__legend-count" data-topping-count>0/2</span>
            </legend>
            <div class="hopecfg__chips topping-grid">
              {%- if meta_topping_count > 0 -%}
                {%- for c in cfg_cats -%}
                  {%- unless c.nombre == 'Sirope' -%}
                    {%- for item in c.items -%}
                      {%- unless item.premium -%}
                        {%- render 'hope-extra-chip', item: item, tipo: 'topping' -%}
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} Fallback sin metafield {%- endcomment -%}
                {%- assign toppings = 'strawberry|🍓|Fresa,pineapple|🍍|Piña,banana|🍌|Cambur,mango|🥭|Mango,peanut|🥜|Maní,oreo|🍪|Oreo negra' | split: ',' -%}
                {%- for t in toppings -%}
                  {%- assign parts = t | split: '|' -%}
                  <button class="hopecfg__choice hopecfg__choice--chip" data-id="{{ parts[0] }}" data-label="{{ parts[2] }}" data-emoji="{{ parts[1] }}" data-precio-cents="0" type="button">
                    <span class="topping-icon">{{ parts[1] }}</span>
                    <span class="topping-name">{{ parts[2] }}</span>
                  </button>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </fieldset>

          {%- comment -%} Toppings premium: opcionales, máximo 1 (+precio) {%- endcomment -%}
          <fieldset id="premium-options" class="hopecfg__group" data-group="premium">
            <legend class="hopecfg__legend">
              Toppings premium <span class="hopecfg__legend-hint">(opcional · máx 1)</span>
            </legend>
            <div class="hopecfg__chips">
              {%- if meta_topping_count > 0 -%}
                {%- for c in cfg_cats -%}
                  {%- unless c.nombre == 'Sirope' -%}
                    {%- for item in c.items -%}
                      {%- if item.premium -%}
                        {%- render 'hope-extra-chip', item: item, tipo: 'topping' -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </fieldset>

          <fieldset id="syrup-options" class="hopecfg__group" data-group="syrup">
            <legend class="hopecfg__legend">3 · Elige 1 sirope <span class="hopecfg__legend-hint">(obligatorio)</span></legend>
            <div class="hopecfg__chips">
              {%- if cat_sirope.items.size > 0 -%}
                {%- for item in cat_sirope.items -%}
                  {%- render 'hope-extra-chip', item: item, tipo: 'syrup' -%}
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} Fallback sin metafield (sin precios) {%- endcomment -%}
                {%- assign syrups = 'chocolate|Chocolate|🍫,berries|Frutos rojos|🍓,passion|Maracuyá|🟡,salted-caramel|Caramelo salado|🍯,white-chocolate|Chocolate blanco|🤍' | split: ',' -%}
                {%- for s in syrups -%}
                  {%- assign parts = s | split: '|' -%}
                  <button
                    class="hopecfg__choice hopecfg__choice--chip"
                    data-id="{{ parts[0] }}"
                    data-label="{{ parts[1] }}"
                    data-emoji="{{ parts[2] }}"
                    data-variant-id=""
                    data-precio-cents="0"
                    type="button"
                  >
                    {{ parts[1] }}
                  </button>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </fieldset>
        </div>

        {%- comment -%} Opciones milkshake {%- endcomment -%}
        <div id="milkshake-options" class="hopecfg__milkshake is-hidden">
          <fieldset class="hopecfg__group" data-group="flavor">
            <legend class="hopecfg__legend">Elige tu sabor</legend>
            <div class="hopecfg__milkshake-grid">
              <button class="hopecfg__choice hopecfg__milkshake-choice is-active" data-id="strawberry" type="button">
                <span class="hopecfg__check"></span>
                <span class="hopecfg__ms-emoji">🍓</span>
                <span class="hopecfg__ms-name">Fresa</span>
                <span class="hopecfg__ms-price" data-flavor-price></span>
              </button>
              <button class="hopecfg__choice hopecfg__milkshake-choice" data-id="vanilla" type="button">
                <span class="hopecfg__check"></span>
                <span class="hopecfg__ms-emoji">🌼</span>
                <span class="hopecfg__ms-name">Vainilla</span>
                <span class="hopecfg__ms-price" data-flavor-price></span>
              </button>
              <button class="hopecfg__choice hopecfg__milkshake-choice" data-id="chocolate" type="button">
                <span class="hopecfg__check"></span>
                <span class="hopecfg__ms-emoji">🍫</span>
                <span class="hopecfg__ms-name">Chocolate</span>
                <span class="hopecfg__ms-price" data-flavor-price></span>
              </button>
            </div>
          </fieldset>
        </div>
      </div>

      <footer class="hopecfg__footer">
        <div class="hopecfg__total">
          <p class="hopecfg__total-label">Total</p>
          <p id="price" class="hopecfg__price">—</p>
          <p id="buy-hint" class="hopecfg__buy-hint"></p>
        </div>
        <div class="hopecfg__actions">
          <button id="reset-view" type="button" class="hopecfg__reset" aria-label="Reiniciar esta vista" title="Reiniciar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 11a8 8 0 1 0-2.34 5.66" />
              <path d="M20 4v7h-7" />
            </svg>
          </button>
          <button id="buy" type="button" class="hopecfg__buy">
            {{ section.settings.texto_boton | default: 'AÑADIR AL CARRITO' }} <span class="hopecfg__buy-arrow">→</span>
          </button>
        </div>
      </footer>
    </section>
  </div>

  <div id="toast" class="hopecfg__toast" role="status" aria-live="polite">¡Tu selección fue añadida! ✨</div>
</div>

{% schema %}
{
  "name": "Configurador Hope",
  "settings": [
    {
      "type": "header",
      "content": "Modo del configurador"
    },
    {
      "type": "select",
      "id": "modo",
      "label": "Producto a configurar",
      "options": [
        { "value": "helado", "label": "Helado Hope" },
        { "value": "mixo", "label": "Helado MIXO (yogurt)" },
        { "value": "milkshake", "label": "Milkshake" }
      ],
      "default": "helado"
    },
    {
      "type": "checkbox",
      "id": "mostrar_tabs",
      "label": "Mostrar pestañas para cambiar de producto",
      "info": "Desactivado: la vista queda enfocada solo en el producto elegido arriba.",
      "default": false
    },
    {
      "type": "header",
      "content": "Marca y textos"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior (eyebrow)",
      "default": "Helado de yogurt griego"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Crea tu helado Hope"
    },
    {
      "type": "text",
      "id": "texto_boton",
      "label": "Texto botón carrito",
      "default": "AÑADIR AL CARRITO"
    },
    {
      "type": "header",
      "content": "Pestañas"
    },
    {
      "type": "text",
      "id": "tab_helado",
      "label": "Etiqueta pestaña Helado",
      "default": "HELADO"
    },
    {
      "type": "text",
      "id": "tab_yogurt",
      "label": "Etiqueta pestaña Yogurts",
      "default": "YOGURTS"
    },
    {
      "type": "text",
      "id": "tab_milkshake",
      "label": "Etiqueta pestaña Milkshakes",
      "default": "MILKSHAKES"
    },
    {
      "type": "header",
      "content": "Productos vinculados (carrito real)"
    },
    {
      "type": "paragraph",
      "content": "Cada pestaña puede vincularse a un producto de Shopify. El tamaño (helado) y el sabor (milkshake) se resuelven a una variante por posición."
    },
    {
      "type": "product",
      "id": "producto_helado",
      "label": "Producto · Helado"
    },
    {
      "type": "product",
      "id": "producto_yogurt",
      "label": "Producto · Yogurt (Mixo)"
    },
    {
      "type": "product",
      "id": "producto_milkshake",
      "label": "Producto · Milkshake"
    },
    {
      "type": "header",
      "content": "Imágenes (Cloudinary)"
    },
    {
      "type": "text",
      "id": "cloudinary_account",
      "label": "Cloud name",
      "default": "slealu5f"
    },
    {
      "type": "text",
      "id": "cloudinary_folder",
      "label": "Carpeta del catálogo",
      "default": "hope/catalog"
    }
  ],
  "presets": [
    {
      "name": "Configurador Hope"
    }
  ]
}
{% endschema %}
