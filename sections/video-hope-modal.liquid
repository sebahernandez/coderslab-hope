{% comment %}
  Section contract.
  Renders a two-column block: a rounded media frame next to a stack of merchant-ordered blocks
  (heading, text, feature cards). With a video configured, the frame plays it inline: muted,
  autoplay, infinite loop, no controls (uploaded file, or a YouTube/Vimeo background embed).
  The image is the uploaded video's poster, and the frame content when there is no video.
  Uploaded videos stay paused on the poster under prefers-reduced-motion.
  Consecutive `feature` blocks are grouped into one grid. Columns stack below 750px.
  @example
  <!-- Add "Video Hope modal" from the theme editor, pick a video (and a poster image), edit its blocks -->
{% endcomment %}

{% liquid
  assign s = section.settings
  assign image_desktop = s.image | default: s.image_mobile
  assign image_mobile = s.image_mobile | default: s.image

  assign ratio = s.image_ratio
  if ratio == 'auto'
    assign ratio = image_desktop.aspect_ratio | default: 1.5
  endif

  assign alt = s.image_alt | default: image_desktop.alt

  # Responsive widths capped at the uploaded file's width (Shopify never upscales),
  # always including the original width so high-DPR screens get the full resolution.
  assign desktop_widths = ''
  assign mobile_srcset = ''
  if image_desktop != blank
    assign candidate_widths = '500,700,900,1100,1400,1800,2200,2600,3000' | split: ','
    for w in candidate_widths
      assign wn = w | plus: 0
      if wn < image_desktop.width
        assign desktop_widths = desktop_widths | append: wn | append: ','
      endif
    endfor
    assign desktop_widths = desktop_widths | append: image_desktop.width

    assign mobile_candidates = '375,550,750,1100,1500' | split: ','
    for w in mobile_candidates
      assign wn = w | plus: 0
      if wn < image_mobile.width
        assign mobile_url = image_mobile | image_url: width: wn
        assign mobile_srcset = mobile_srcset | append: mobile_url | append: ' ' | append: wn | append: 'w, '
      endif
    endfor
    assign mobile_url = image_mobile | image_url: width: image_mobile.width
    assign mobile_srcset = mobile_srcset | append: mobile_url | append: ' ' | append: image_mobile.width | append: 'w'
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  # object-fit: cover crops images wider than the frame, so only part of the file's width
  # is visible. Scale `sizes` by that crop factor so the browser downloads enough pixels
  # for the visible area instead of assuming the whole image is shown.
  assign frame_ratio = ratio | times: 1.0
  assign crop_desktop = 1
  if image_desktop != blank and image_desktop.aspect_ratio > frame_ratio
    assign crop_desktop = image_desktop.aspect_ratio | divided_by: frame_ratio | round: 3
  endif
  assign crop_mobile = 1
  if image_mobile != blank and image_mobile.aspect_ratio > frame_ratio
    assign crop_mobile = image_mobile.aspect_ratio | divided_by: frame_ratio | round: 3
  endif

  assign desktop_vw = s.media_width | append: 'vw'
  assign mobile_vw = '100vw'
  if crop_desktop > 1
    assign desktop_vw = 'calc(' | append: s.media_width | append: 'vw * ' | append: crop_desktop | append: ')'
    assign mobile_vw = 'calc(100vw * ' | append: crop_desktop | append: ')'
  endif
  assign mobile_source_sizes = '100vw'
  if crop_mobile > 1
    assign mobile_source_sizes = 'calc(100vw * ' | append: crop_mobile | append: ')'
  endif

  if s.layout_width == 'full'
    assign sizes = '(min-width: 750px) ' | append: desktop_vw | append: ', ' | append: mobile_vw
  else
    assign sizes_px = 1600 | times: s.media_width | divided_by: 100 | times: crop_desktop | round
    assign sizes = '(min-width: 1600px) ' | append: sizes_px | append: 'px, (min-width: 750px) ' | append: desktop_vw | append: ', ' | append: mobile_vw
  endif

  case s.content_align
    when 'center'
      assign items = 'center'
    when 'end'
      assign items = 'flex-end'
    else
      assign items = 'flex-start'
  endcase

  assign has_video = false
  assign video_url = s.video_url
  if s.video_source == 'uploaded' and s.video != blank
    assign has_video = true
  elsif s.video_source == 'url' and video_url != blank
    assign has_video = true
  endif

  assign video_title = 'accessibility.play_video' | t
  for block in section.blocks
    if block.type == 'heading' and block.settings.heading != blank
      assign video_title = block.settings.heading | strip_html
      break
    endif
  endfor

  assign in_grid = false
%}

<div
  class="video-hope-modal color-{{ s.color_scheme }} video-hope-modal--media-{{ s.media_side }} video-hope-modal--mobile-media-{{ s.mobile_media_order }}"
  style="
    --vhm-pad-top: {{ s.padding_top }}px;
    --vhm-pad-bottom: {{ s.padding_bottom }}px;
    --vhm-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --vhm-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --vhm-gap: {{ s.gap }}px;
    --vhm-gap-mobile: {{ s.gap_mobile }}px;
    --vhm-media-width: {{ s.media_width }}%;
    --vhm-align-v: {{ s.vertical_align }};
    --vhm-text-align: {{ s.content_align }};
    --vhm-items: {{ items }};
    --vhm-ratio: {{ ratio }};
    --vhm-radius: {{ s.image_radius }}px;
    --vhm-cols: {{ s.feature_columns }};
    --vhm-cols-mobile: {{ s.feature_columns_mobile }};
    --vhm-feature-gap: {{ s.feature_gap }}px;
    --vhm-feature-gap-mobile: {{ s.feature_gap_mobile }}px;
    {% if s.background != blank %}--vhm-bg: {{ s.background }};{% endif %}
    {% if s.overlay_enabled %}--vhm-overlay-rgb: {{ s.overlay_color.red | default: 0 }} {{ s.overlay_color.green | default: 0 }} {{ s.overlay_color.blue | default: 0 }}; --vhm-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};{% endif %}
  "
>
  <div class="video-hope-modal__inner video-hope-modal__inner--{{ s.layout_width }}">
    <div class="video-hope-modal__media">
      <div class="video-hope-modal__frame">
        {%- if has_video -%}
          {%- if s.video_source == 'uploaded' -%}
            {%- liquid
              assign poster = s.video.preview_image
              if image_desktop != blank
                assign poster = image_desktop
              endif
            -%}
            {%- comment -%} Decorative ambient loop: muted is required by browsers for autoplay. {%- endcomment -%}
            <video
              class="video-hope-modal__video"
              autoplay
              muted
              loop
              playsinline
              disablepictureinpicture
              preload="metadata"
              {% if poster != blank %}poster="{{ poster | image_url: width: 1400 }}"{% endif %}
              aria-hidden="true"
              tabindex="-1"
            >
              {%- for source in s.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif video_url.type == 'youtube' -%}
            <iframe
              class="video-hope-modal__video video-hope-modal__video--embed"
              src="https://www.youtube-nocookie.com/embed/{{ video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ video_url.id }}&controls=0&playsinline=1&rel=0&modestbranding=1&disablekb=1"
              title="{{ video_title | escape }}"
              allow="autoplay; encrypted-media; picture-in-picture"
              loading="lazy"
              tabindex="-1"
              aria-hidden="true"
              frameborder="0"
            ></iframe>
          {%- elsif video_url.type == 'vimeo' -%}
            <iframe
              class="video-hope-modal__video video-hope-modal__video--embed"
              src="https://player.vimeo.com/video/{{ video_url.id }}?background=1"
              title="{{ video_title | escape }}"
              allow="autoplay; encrypted-media; picture-in-picture"
              loading="lazy"
              tabindex="-1"
              aria-hidden="true"
              frameborder="0"
            ></iframe>
          {%- endif -%}
        {%- elsif image_desktop != blank -%}
          <picture class="video-hope-modal__picture">
            {%- if image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_srcset }}"
                sizes="{{ mobile_source_sizes }}"
                width="{{ image_mobile.width }}"
                height="{{ image_mobile.height }}"
              >
            {%- endif -%}
            {{
              image_desktop
              | image_url: width: image_desktop.width
              | image_tag:
                widths: desktop_widths,
                sizes: sizes,
                alt: alt,
                loading: loading,
                fetchpriority: fetchpriority,
                class: 'video-hope-modal__image'
            }}
          </picture>
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'video-hope-modal__image video-hope-modal__placeholder' }}
        {%- endif -%}

        {%- if s.overlay_enabled -%}
          <span
            class="video-hope-modal__overlay{% if s.overlay_gradient %} video-hope-modal__overlay--gradient{% endif %}"
            aria-hidden="true"
          ></span>
        {%- endif -%}

      </div>
    </div>

    <div class="video-hope-modal__content">
      {%- # theme-check-disable UnclosedHTMLElement -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          {%- unless in_grid -%}
            <div class="video-hope-modal__features">
            {%- assign in_grid = true -%}
          {%- endunless -%}

          {%- assign b = block.settings -%}
          <div
            class="video-hope-modal__feature"
            style="
              --vhm-f-pad: {{ b.padding }}px;
              --vhm-f-pad-mobile: {{ b.padding_mobile }}px;
              --vhm-f-radius: {{ b.radius }}px;
              --vhm-f-title-size: {{ b.title_size }}px;
              --vhm-f-title-size-mobile: {{ b.title_size_mobile }}px;
              --vhm-f-text-size: {{ b.text_size }}px;
              --vhm-f-text-size-mobile: {{ b.text_size_mobile }}px;
              {% if b.card_bg != blank %}--vhm-f-bg: {{ b.card_bg }};{% endif %}
              {% if b.icon_bg != blank %}--vhm-f-icon-bg: {{ b.icon_bg }};{% endif %}
              {% if b.icon_color != blank %}--vhm-f-icon-color: {{ b.icon_color }};{% endif %}
              {% if b.title_color != blank %}--vhm-f-title-color: {{ b.title_color }};{% endif %}
              {% if b.text_color != blank %}--vhm-f-text-color: {{ b.text_color }};{% endif %}
            "
            {{ block.shopify_attributes }}
          >
            {%- if b.icon_svg != blank or b.icon_image != blank -%}
              <span class="video-hope-modal__feature-icon"{% if b.icon_svg != blank or b.icon_alt == blank %} aria-hidden="true"{% endif %}>
                {%- if b.icon_svg != blank -%}
                  {{- b.icon_svg -}}
                {%- else -%}
                  {{
                    b.icon_image
                    | image_url: width: 64
                    | image_tag:
                      width: 16,
                      height: 16,
                      alt: b.icon_alt,
                      loading: 'lazy',
                      class: 'video-hope-modal__feature-image'
                  }}
                {%- endif -%}
              </span>
            {%- endif -%}
            {%- if b.title != blank -%}
              <p class="video-hope-modal__feature-title">{{ b.title | escape }}</p>
            {%- endif -%}
            {%- if b.text != blank -%}
              <p class="video-hope-modal__feature-text">{{ b.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- if in_grid -%}
            </div>
            {%- assign in_grid = false -%}
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- if block.settings.heading != blank -%}
                {%- assign tag = block.settings.tag -%}
                <{{ tag }}
                  class="video-hope-modal__heading"
                  style="--vhm-size: {{ block.settings.size }}px; --vhm-size-mobile: {{ block.settings.size_mobile }}px; --vhm-weight: {{ block.settings.weight }}; --vhm-line: {{ block.settings.line_height | divided_by: 100.0 }}; --vhm-space: {{ block.settings.spacing_bottom }}px; --vhm-space-mobile: {{ block.settings.spacing_bottom_mobile }}px;{% if block.settings.color != blank %} --vhm-color: {{ block.settings.color }};{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.heading | escape -}}
                </{{ tag }}>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div
                  class="video-hope-modal__text"
                  style="--vhm-size: {{ block.settings.size }}px; --vhm-size-mobile: {{ block.settings.size_mobile }}px; --vhm-max: {{ block.settings.max_width }}ch; --vhm-space: {{ block.settings.spacing_bottom }}px; --vhm-space-mobile: {{ block.settings.spacing_bottom_mobile }}px;{% if block.settings.color != blank %} --vhm-color: {{ block.settings.color }};{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if in_grid -%}
        </div>
      {%- endif -%}
      {%- # theme-check-enable UnclosedHTMLElement -%}
    </div>
  </div>
</div>

{%- if has_video and s.video_source == 'uploaded' -%}
  <script type="module">
    // Respect reduced motion: keep the uploaded loop paused on its poster.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      for (const video of document.querySelectorAll('#shopify-section-{{ section.id }} video.video-hope-modal__video')) {
        video.removeAttribute('autoplay');
        video.pause();
        video.currentTime = 0;
      }
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .video-hope-modal {
    padding-block: var(--vhm-pad-top) var(--vhm-pad-bottom);
    background-color: var(--vhm-bg, var(--color-background));
    color: var(--color-foreground);
    overflow-x: clip;
  }

  .video-hope-modal__inner {
    box-sizing: border-box;
    display: flex;
    align-items: var(--vhm-align-v, center);
    gap: var(--vhm-gap);
    width: 100%;
    margin-inline: auto;
  }

  .video-hope-modal__inner--page {
    max-width: var(--page-width);
    padding-inline: var(--page-margin);
  }

  .video-hope-modal__inner--full {
    padding-inline: var(--page-margin);
  }

  .video-hope-modal--media-end .video-hope-modal__media {
    order: 1;
  }

  .video-hope-modal__media {
    flex: 0 0 var(--vhm-media-width);
    min-width: 0;
  }

  .video-hope-modal__frame {
    position: relative;
    overflow: hidden;
    /* isolation keeps Safari clipping the composited video to the rounded corners. */
    isolation: isolate;
    aspect-ratio: var(--vhm-ratio);
    border-radius: var(--vhm-radius);
  }

  .video-hope-modal__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .video-hope-modal__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
  }

  .video-hope-modal__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-color: rgb(var(--vhm-overlay-rgb) / var(--vhm-overlay-opacity));
  }

  /* YouTube-style vignette: darker top and bottom edges, clear center. */
  .video-hope-modal__overlay--gradient {
    background-image: linear-gradient(
      to bottom,
      rgb(var(--vhm-overlay-rgb) / 0.5) 0%,
      rgb(var(--vhm-overlay-rgb) / 0) 30%,
      rgb(var(--vhm-overlay-rgb) / 0) 55%,
      rgb(var(--vhm-overlay-rgb) / 0.6) 100%
    );
  }

  .video-hope-modal__placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5, 0.05));
  }

  /* Fills the rounded frame; the frame's overflow: hidden clips the corners. */
  .video-hope-modal__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    pointer-events: none;
  }

  /* Iframes can't use object-fit: scale the 16:9 player until it covers the frame. */
  .video-hope-modal__video--embed {
    inset: auto;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: max(100%, calc(100% * 1.7778 / var(--vhm-ratio)));
    height: auto;
    aspect-ratio: 16 / 9;
    transform: translate(-50%, -50%);
  }

  [dir='rtl'] .video-hope-modal__video--embed {
    transform: translate(50%, -50%);
  }

  .video-hope-modal__content {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: var(--vhm-items);
    min-width: 0;
    text-align: var(--vhm-text-align);
    overflow-wrap: break-word;
  }

  .video-hope-modal__content > * {
    margin-block: 0 var(--vhm-space, 0);
  }

  .video-hope-modal__content > *:last-child {
    margin-block-end: 0;
  }

  .video-hope-modal__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--vhm-weight, 700);
    font-size: var(--vhm-size);
    line-height: var(--vhm-line, 1.15);
    color: var(--vhm-color, var(--color-foreground-heading, var(--color-foreground)));
    text-wrap: balance;
  }

  .video-hope-modal__text {
    max-width: var(--vhm-max, 60ch);
    font-family: var(--font-body--family);
    font-size: var(--vhm-size);
    line-height: 1.5;
    color: var(--vhm-color, var(--color-foreground));
  }

  .video-hope-modal__text > * {
    margin: 0;
  }

  .video-hope-modal__text > * + * {
    margin-block-start: 0.75em;
  }

  .video-hope-modal__features {
    display: grid;
    grid-template-columns: repeat(var(--vhm-cols), minmax(0, 1fr));
    gap: var(--vhm-feature-gap);
    align-self: stretch;
    margin-block-end: 0;
    text-align: start;
  }

  .video-hope-modal__content > .video-hope-modal__features + * {
    margin-block-start: 24px;
  }

  .video-hope-modal__feature {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
    padding: var(--vhm-f-pad);
    border-radius: var(--vhm-f-radius);
    background-color: var(--vhm-f-bg, rgb(var(--color-foreground-rgb) / var(--opacity-5, 0.05)));
  }

  .video-hope-modal__feature-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    margin-block-end: 4px;
    border-radius: 50%;
    background-color: var(--vhm-f-icon-bg, var(--color-background));
    color: var(--vhm-f-icon-color, var(--color-foreground));
  }

  .video-hope-modal__feature-icon svg,
  .video-hope-modal__feature-image {
    display: block;
    width: 16px;
    height: 16px;
  }

  .video-hope-modal__feature-title,
  .video-hope-modal__feature-text {
    margin: 0;
    max-width: 100%;
  }

  .video-hope-modal__feature-title {
    font-family: var(--font-body--family);
    font-size: var(--vhm-f-title-size);
    font-weight: 700;
    line-height: 1.25;
    color: var(--vhm-f-title-color, var(--color-foreground));
  }

  .video-hope-modal__feature-text {
    font-family: var(--font-body--family);
    font-size: var(--vhm-f-text-size);
    line-height: 1.45;
    color: var(--vhm-f-text-color, rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7)));
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .video-hope-modal__inner {
      gap: min(var(--vhm-gap), 32px);
    }

    .video-hope-modal__heading {
      font-size: min(var(--vhm-size), 32px);
    }

    .video-hope-modal__features {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 140px), 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .video-hope-modal {
      padding-block: var(--vhm-pad-top-mobile) var(--vhm-pad-bottom-mobile);
    }

    .video-hope-modal__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--vhm-gap-mobile);
    }

    .video-hope-modal--mobile-media-first .video-hope-modal__media {
      order: -1;
    }

    .video-hope-modal--mobile-media-last .video-hope-modal__media {
      order: 1;
    }

    .video-hope-modal__media {
      flex: 0 0 auto;
      width: 100%;
    }

    .video-hope-modal__content {
      flex: 0 1 auto;
    }

    .video-hope-modal__content > * {
      margin-block-end: var(--vhm-space-mobile, var(--vhm-space, 0));
    }

    .video-hope-modal__content > *:last-child {
      margin-block-end: 0;
    }

    .video-hope-modal__heading,
    .video-hope-modal__text {
      font-size: var(--vhm-size-mobile);
    }

    .video-hope-modal__features {
      grid-template-columns: repeat(var(--vhm-cols-mobile), minmax(0, 1fr));
      gap: var(--vhm-feature-gap-mobile);
    }

    .video-hope-modal__feature {
      padding: var(--vhm-f-pad-mobile);
    }

    .video-hope-modal__feature-title {
      font-size: var(--vhm-f-title-size-mobile);
    }

    .video-hope-modal__feature-text {
      font-size: var(--vhm-f-text-size-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video Hope modal",
  "tag": "section",
  "class": "video-hope-modal-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen escritorio"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen móvil",
      "info": "Opcional. Se muestra en pantallas de 749 px o menos; si está vacía se usa la de escritorio."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo",
      "info": "Si está vacío se usa el texto alternativo de la imagen."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "options": [
        {
          "value": "auto",
          "label": "Automática (según la imagen)"
        },
        {
          "value": "1.7778",
          "label": "Panorámica 16:9"
        },
        {
          "value": "1.5",
          "label": "Horizontal 3:2"
        },
        {
          "value": "1.3333",
          "label": "Horizontal 4:3"
        },
        {
          "value": "1",
          "label": "Cuadrada"
        },
        {
          "value": "0.8",
          "label": "Vertical 4:5"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Radio de borde",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Overlay de la imagen"
    },
    {
