{{ 'section-custom-title.css' | asset_url | stylesheet_tag }}

<div class="custom-title-section" 
     style="
       padding-top: {{ section.settings.padding_top }}px;
       padding-bottom: {{ section.settings.padding_bottom }}px;
       min-height: {{ section.settings.section_height }}px;
       display: flex;
       align-items: {{ section.settings.vertical_alignment }};
       justify-content: {{ section.settings.horizontal_alignment }};
       text-align: {{ section.settings.text_alignment }};
     ">
  <div class="custom-title-content">
    {% if section.settings.title != blank %}
      <h2 class="custom-title" 
          style="
            font-size: {{ section.settings.title_size }}px;
            color: {{ section.settings.title_color }};
            margin-bottom: {{ section.settings.title_margin_bottom }}px;
          ">
        {{ section.settings.title }}
      </h2>
    {% endif %}
    
    {% if section.settings.subtitle != blank %}
      <p class="custom-subtitle" 
         style="
           font-size: {{ section.settings.subtitle_size }}px;
           color: {{ section.settings.subtitle_color }};
           margin-bottom: 0;
         ">
        {{ section.settings.subtitle }}
      </p>
    {% endif %}
  </div>
</div>

<style>
  .custom-title-section {
    width: 100%;
    position: relative;
  }

  .custom-title-content {
    max-width: 100%;
    width: 100%;
  }

  .custom-title {
    margin-top: 0;
    line-height: 1.2;
    font-weight: bold;
  }

  .custom-subtitle {
    line-height: 1.4;
    margin-top: 0;
  }

  /* Responsive adjustments */
  @media screen and (max-width: 768px) {
    .custom-title {
      font-size: calc({{ section.settings.title_size }}px * 0.8) !important;
    }
    
    .custom-subtitle {
      font-size: calc({{ section.settings.subtitle_size }}px * 0.9) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Title",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Contenido de Texto"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "¡NOS ENCANTARÍA SABER DE TI!"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo/Párrafo",
      "default": "Si tienes alguna pregunta, comentario o simplemente quieres decir hola, no dudes en contactarnos."
    },
    {
      "type": "header",
      "content": "Configuración de Título"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del Título",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del Título",
      "default": "#ec4899"
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Espaciado debajo del título",
      "default": 16
    },
    {
      "type": "header",
      "content": "Configuración de Subtítulo"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del Subtítulo",
      "default": 16
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Color del Subtítulo",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Alineación y Posicionamiento"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del Texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Alineación Horizontal (Flexbox)",
      "options": [
        {
          "value": "flex-start",
          "label": "Inicio (Izquierda)"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "flex-end",
          "label": "Final (Derecha)"
        },
        {
          "value": "space-between",
          "label": "Espacio entre elementos"
        },
        {
          "value": "space-around",
          "label": "Espacio alrededor"
        },
        {
          "value": "space-evenly",
          "label": "Espacio uniforme"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Alineación Vertical (Flexbox)",
      "options": [
        {
          "value": "flex-start",
          "label": "Arriba"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "flex-end",
          "label": "Abajo"
        },
        {
          "value": "stretch",
          "label": "Estirar"
        },
        {
          "value": "baseline",
          "label": "Línea base"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Espaciado y Dimensiones"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Superior",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Inferior",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Altura Mínima de la Sección",
      "default": 200
    }
  ],
  "presets": [
    {
      "name": "Custom Title",
      "settings": {
        "title": "¡NOS ENCANTARÍA SABER DE TI!",
        "subtitle": "Si tienes alguna pregunta, comentario o simplemente quieres decir hola, no dudes en contactarnos.",
        "title_color": "#ec4899",
        "subtitle_color": "#666666",
        "text_alignment": "center",
        "padding_top": 50,
        "padding_bottom": 50
      }
    }
  ]
}
{% endschema %}
