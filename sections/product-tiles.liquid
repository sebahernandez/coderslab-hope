{% comment %}
  Section contract.
  Renders a heading and a responsive grid of product tiles. Each tile is a `product-tile`
  theme block that owns its image, copy, button and spacing, and can inherit them from a
  selected product. The section owns the heading, the column count per breakpoint
  (desktop, tablet up to 989px, mobile up to 749px), gaps, color scheme and padding.
  Without blocks only the heading renders.
  @example
  <!-- Add "Tarjetas de productos" from the theme editor and add "Tarjeta de producto" blocks -->
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h2'
-%}
<div
  class="product-tiles color-{{ s.color_scheme }}"
  style="
    --pts-pad-top: {{ s.padding_top }}px;
    --pts-pad-bottom: {{ s.padding_bottom }}px;
    --pts-pad-top-m: {{ s.padding_top_mobile }}px;
    --pts-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
    --pts-max: {{ s.content_max_width }}px;
    --pts-heading-align: {{ s.heading_align }};
    --pts-heading-size: {{ s.heading_size }}px;
    --pts-heading-size-m: {{ s.heading_size_mobile }}px;
    --pts-heading-space: {{ s.heading_spacing }}px;
    --pts-heading-space-m: {{ s.heading_spacing_mobile }}px;
    --pts-cols: {{ s.columns_desktop }};
    --pts-cols-t: {{ s.columns_tablet }};
    --pts-cols-m: {{ s.columns_mobile }};
    --pts-gap: {{ s.gap }}px;
    --pts-gap-m: {{ s.gap_mobile }}px;
    --pts-row-gap: {{ s.row_gap }}px;
    --pts-row-gap-m: {{ s.row_gap_mobile }}px;
    {%- if s.background != blank %} --pts-bg: {{ s.background }};{% endif -%}
    {%- if s.heading_color != blank %} --pts-heading-color: {{ s.heading_color }};{% endif -%}
  "
>
  <div class="product-tiles__inner product-tiles__inner--{{ s.layout_width }}">
    {%- if s.heading != blank -%}
      <{{ heading_tag }} class="product-tiles__heading">{{ s.heading | escape }}</{{ heading_tag }}>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="product-tiles__grid">
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-tiles {
    padding-block: var(--pts-pad-top) var(--pts-pad-bottom);
    background-color: var(--pts-bg, var(--color-background));
    color: var(--color-foreground);
  }

  .product-tiles__inner {
    box-sizing: border-box;
    width: 100%;
    margin-inline: auto;
  }

  .product-tiles__inner--page {
    max-width: min(var(--pts-max), var(--page-width, 100%));
    padding-inline: var(--page-margin);
  }

  .product-tiles__inner--full {
    padding-inline: var(--page-margin);
  }

  .product-tiles__heading {
    margin: 0 0 var(--pts-heading-space);
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 700;
    font-size: var(--pts-heading-size);
    line-height: 1.15;
    text-align: var(--pts-heading-align);
    overflow-wrap: break-word;
    color: var(--pts-heading-color, var(--color-foreground-heading, var(--color-foreground)));
  }

  .product-tiles__grid {
    display: grid;
    grid-template-columns: repeat(var(--pts-cols), minmax(0, 1fr));
    gap: var(--pts-row-gap) var(--pts-gap);
    min-width: 0;
  }

  @media screen and (max-width: 989px) {
    .product-tiles__grid {
      grid-template-columns: repeat(var(--pts-cols-t), minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .product-tiles {
      padding-block: var(--pts-pad-top-m) var(--pts-pad-bottom-m);
    }

    .product-tiles__heading {
      margin-block-end: var(--pts-heading-space-m);
      font-size: var(--pts-heading-size-m);
    }

    .product-tiles__grid {
      grid-template-columns: repeat(var(--pts-cols-m), minmax(0, 1fr));
      gap: var(--pts-row-gap-m) var(--pts-gap-m);
    }
  }
{% endstylesheet %}

{% schema %}
{
