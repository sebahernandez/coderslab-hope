{% comment %}
  Section contract.
  Renders a two-column banner: an image (independent desktop/mobile, optional link) next
  to a stack of content blocks: heading, text and social buttons. Each social button links
  to a profile with its own target (_blank or _self), network icon (from the `icon`
  snippet), style, colors and size. Consecutive social buttons share one wrapping row.
  The section owns the image and the layout (image side, mobile order, column width, gaps,
  vertical alignment) with mobile variants. Columns stack below 750px.
  @example
  <!-- Add "Social Hope" from the theme editor and edit its blocks -->
{% endcomment %}

{% liquid
  assign s = section.settings
  assign image_desktop = s.image | default: s.image_mobile
  assign image_mobile = s.image_mobile | default: s.image

  assign ratio = s.image_ratio
  if ratio == 'auto'
    assign ratio = image_desktop.aspect_ratio | default: 1
  endif
  assign ratio_mobile = ratio
  if s.image_ratio == 'auto' and image_mobile != blank
    assign ratio_mobile = image_mobile.aspect_ratio | default: ratio
  endif

  assign alt = s.image_alt | default: image_desktop.alt | escape

  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign sizes = '(min-width: 750px) ' | append: s.media_width | append: 'vw, 100vw'

  case s.text_align
    when 'center'
      assign items = 'center'
    when 'end'
      assign items = 'flex-end'
    else
      assign items = 'flex-start'
  endcase

  assign in_row = false
%}

<div
  class="social-hope color-{{ s.color_scheme }} social-hope--media-{{ s.media_side }} social-hope--mobile-media-{{ s.mobile_media_order }}"
  style="
    --sh-pad-top: {{ s.padding_top }}px;
    --sh-pad-bottom: {{ s.padding_bottom }}px;
    --sh-pad-top-m: {{ s.padding_top_mobile }}px;
    --sh-pad-bottom-m: {{ s.padding_bottom_mobile }}px;
    --sh-max: {{ s.content_max_width }}px;
    --sh-gap: {{ s.gap }}px;
    --sh-gap-m: {{ s.gap_mobile }}px;
    --sh-media-width: {{ s.media_width }}%;
    --sh-align-v: {{ s.vertical_align }};
    --sh-text-align: {{ s.text_align }};
    --sh-items: {{ items }};
    --sh-ratio: {{ ratio }};
    --sh-ratio-m: {{ ratio_mobile }};
    --sh-radius: {{ s.image_radius }}px;
    --sh-btn-gap: {{ s.button_gap }}px;
    {%- if s.background != blank %} --sh-bg: {{ s.background }};{% endif -%}
  "
>
  <div class="social-hope__inner social-hope__inner--{{ s.layout_width }}">
    <div class="social-hope__media">
      {%- if s.image_link != blank -%}
        <a class="social-hope__frame" href="{{ s.image_link }}" aria-label="{{ alt | default: section.settings.image_link_label | escape }}">
      {%- else -%}
        <div class="social-hope__frame">
      {%- endif -%}

      {%- if image_desktop != blank -%}
        <picture class="social-hope__picture">
          {%- if s.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ image_mobile | image_url: width: 375 }} 375w, {{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1125 }} 1125w"
              sizes="100vw"
              width="{{ image_mobile.width }}"
              height="{{ image_mobile.height }}"
            >
          {%- endif -%}
          {{
            image_desktop
            | image_url: width: 1600
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: sizes,
              alt: alt,
              loading: loading,
              fetchpriority: fetchpriority,
              class: 'social-hope__image'
          }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'social-hope__image social-hope__placeholder' }}
      {%- endif -%}

      {%- if s.image_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    </div>

    <div class="social-hope__content">
      {%- # theme-check-disable UnclosedHTMLElement -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}

        {%- if block.type != 'social_button' and in_row -%}
          </div>
          {%- assign in_row = false -%}
        {%- endif -%}

        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if b.heading != blank -%}
              {%- assign tag = b.tag | default: 'h2' -%}
              <{{ tag }}
                class="social-hope__heading"
                style="--sh-size: {{ b.size }}px; --sh-size-m: {{ b.size_mobile }}px; --sh-weight: {{ b.weight }}; --sh-space: {{ b.spacing_bottom }}px; --sh-space-m: {{ b.spacing_bottom_mobile }}px;{% if b.color != blank %} --sh-color: {{ b.color }};{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- b.heading | escape -}}
              </{{ tag }}>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if b.text != blank -%}
              <div
                class="social-hope__text"
                style="--sh-size: {{ b.size }}px; --sh-size-m: {{ b.size_mobile }}px; --sh-max-ch: {{ b.max_width }}ch; --sh-space: {{ b.spacing_bottom }}px; --sh-space-m: {{ b.spacing_bottom_mobile }}px;{% if b.color != blank %} --sh-color: {{ b.color }};{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- b.text -}}
              </div>
            {%- endif -%}

          {%- when 'social_button' -%}
            {%- liquid
              assign has_link = false
              if b.link != blank
                assign has_link = true
              endif
              assign has_content = false
              if b.label != blank or b.network != 'none'
                assign has_content = true
              endif
              assign show_button = false
              if has_content
                if has_link or request.design_mode
                  assign show_button = true
                endif
              endif

              case b.network
                when 'instagram'
                  assign network_name = 'Instagram'
                when 'tiktok'
                  assign network_name = 'TikTok'
                when 'facebook'
                  assign network_name = 'Facebook'
                when 'whatsapp'
                  assign network_name = 'WhatsApp'
                when 'youtube'
                  assign network_name = 'YouTube'
                when 'x'
                  assign network_name = 'X'
                when 'threads'
                  assign network_name = 'Threads'
                when 'pinterest'
                  assign network_name = 'Pinterest'
                when 'spotify'
                  assign network_name = 'Spotify'
                else
                  assign network_name = ''
              endcase
            -%}

            {%- if show_button -%}
              {%- unless in_row -%}
                <div class="social-hope__buttons">
                {%- assign in_row = true -%}
              {%- endunless -%}

              <a
                class="social-hope__button social-hope__button--{{ b.style }} social-hope__button--{{ b.size }} social-hope__button--icon-{{ b.icon_position }}{% if b.full_width_mobile %} social-hope__button--full-mobile{% endif %}{% unless has_link %} social-hope__button--disabled{% endunless %}"
                {% if has_link %}
                  href="{{ b.link }}"
                  {% if b.target == '_blank' %}
                    target="_blank" rel="noopener noreferrer"
                  {% endif %}
                {% else %}
                  role="link"
                  aria-disabled="true"
                {% endif %}
                {% if b.label == blank and network_name != blank %}
                  aria-label="{{ network_name }}"
                {% endif %}
                style="--sh-btn-radius: {{ b.radius }}px;{% if b.background != blank %} --sh-btn-bg: {{ b.background }};{% endif %}{% if b.text_color != blank %} --sh-btn-fg: {{ b.text_color }};{% endif %}{% if b.border_color != blank %} --sh-btn-border: {{ b.border_color }};{% endif %}{% if b.icon_color != blank %} --sh-btn-icon: {{ b.icon_color }};{% endif %}{% if b.background_hover != blank %} --sh-btn-bg-hover: {{ b.background_hover }};{% endif %}{% if b.text_hover != blank %} --sh-btn-fg-hover: {{ b.text_hover }};{% endif %}{% if b.border_hover != blank %} --sh-btn-border-hover: {{ b.border_hover }};{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if b.label != blank -%}
                  <span class="social-hope__button-label">{{ b.label | escape }}</span>
                {%- endif -%}
                {%- if b.network != 'none' -%}
                  <svg
                    class="social-hope__button-icon"
                    aria-hidden="true"
                    focusable="false"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                  >
                    {%- render 'icon', icon: b.network -%}
                  </svg>
                {%- endif -%}
              </a>
            {%- endif -%}
        {%- endcase -%}

        {%- if forloop.last and in_row -%}
          </div>
          {%- assign in_row = false -%}
        {%- endif -%}
      {%- endfor -%}
      {%- # theme-check-enable UnclosedHTMLElement -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .social-hope {
    padding-block: var(--sh-pad-top) var(--sh-pad-bottom);
    background-color: var(--sh-bg, var(--color-background));
    color: var(--color-foreground);
  }

  .social-hope__inner {
    box-sizing: border-box;
    display: flex;
    align-items: var(--sh-align-v, center);
    gap: var(--sh-gap);
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--page-margin, 16px);
  }

  .social-hope__inner--page {
    max-width: min(var(--sh-max), var(--page-width, 1200px));
  }

  .social-hope__media {
    flex: 0 0 var(--sh-media-width);
    min-width: 0;
  }

  .social-hope--media-end .social-hope__media {
    order: 1;
  }

  .social-hope__frame {
    display: block;
    overflow: hidden;
    aspect-ratio: var(--sh-ratio);
    border-radius: var(--sh-radius);
  }

  .social-hope__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .social-hope__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  a.social-hope__frame:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .social-hope__content {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: var(--sh-items);
    min-width: 0;
    text-align: var(--sh-text-align);
    overflow-wrap: break-word;
  }

  .social-hope__content > * {
    margin-block: 0 var(--sh-space, 0);
  }

  .social-hope__content > *:last-child {
    margin-block-end: 0;
  }

  .social-hope__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--sh-weight, 700);
    font-size: var(--sh-size);
    line-height: 1.1;
    color: var(--sh-color, var(--color-foreground-heading, var(--color-foreground)));
    text-wrap: balance;
  }

  .social-hope__text {
    max-width: var(--sh-max-ch, 60ch);
    font-family: var(--font-body--family);
    font-size: var(--sh-size);
    line-height: 1.6;
    color: var(--sh-color, rgb(var(--color-foreground-rgb) / 0.8));
  }

  .social-hope__text > * {
    margin: 0;
  }

  .social-hope__text > * + * {
    margin-block-start: 0.6em;
  }

  .social-hope__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: var(--sh-items);
    gap: var(--sh-btn-gap);
    max-width: 100%;
  }

  .social-hope__button {
    --sh-btn-current-bg: var(--sh-btn-bg, transparent);
    --sh-btn-current-fg: var(--sh-btn-fg, var(--color-foreground));
    --sh-btn-current-border: var(--sh-btn-border, rgb(var(--color-foreground-rgb) / 0.2));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 44px;
    max-width: 100%;
    border: 1px solid var(--sh-btn-current-border);
    border-radius: var(--sh-btn-radius, 999px);
    background-color: var(--sh-btn-current-bg);
    color: var(--sh-btn-current-fg);
    font-family: var(--font-body--family);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      border-color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .social-hope__button--solid {
    --sh-btn-current-bg: var(--sh-btn-bg, var(--color-foreground));
    --sh-btn-current-fg: var(--sh-btn-fg, var(--color-background));
    --sh-btn-current-border: var(--sh-btn-border, var(--sh-btn-bg, var(--color-foreground)));
  }

  .social-hope__button:hover {
    --sh-btn-current-bg: var(--sh-btn-bg-hover, var(--sh-btn-bg, transparent));
    --sh-btn-current-fg: var(--sh-btn-fg-hover, var(--sh-btn-fg, var(--color-foreground)));
    --sh-btn-current-border: var(--sh-btn-border-hover, var(--sh-btn-border, currentColor));
  }

  .social-hope__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .social-hope__button--icon-start .social-hope__button-icon {
    order: -1;
  }

  .social-hope__button--small {
    padding: 0.45em 1em;
    font-size: 0.8125rem;
  }

  .social-hope__button--medium {
    padding: 0.65em 1.25em;
    font-size: 0.9375rem;
  }

  .social-hope__button--large {
    padding: 0.85em 1.6em;
    font-size: 1.0625rem;
  }

  .social-hope__button-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .social-hope__button-icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    color: var(--sh-btn-icon, currentColor);
    fill: currentColor;
  }

  .social-hope__button:hover .social-hope__button-icon {
    color: var(--sh-btn-fg-hover, var(--sh-btn-icon, currentColor));
  }

  .social-hope__button--disabled {
    opacity: 0.5;
    cursor: default;
  }

  @media screen and (max-width: 749px) {
    .social-hope {
      padding-block: var(--sh-pad-top-m) var(--sh-pad-bottom-m);
    }

    .social-hope__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--sh-gap-m);
    }

    .social-hope__media {
      flex-basis: auto;
      order: 0;
    }

    .social-hope--mobile-media-last .social-hope__media {
      order: 1;
    }

    .social-hope--media-end.social-hope--mobile-media-first .social-hope__media {
      order: 0;
    }

    .social-hope__frame {
      aspect-ratio: var(--sh-ratio-m);
    }

    .social-hope__content > * {
      margin-block-end: var(--sh-space-m, var(--sh-space, 0));
    }

    .social-hope__content > *:last-child {
      margin-block-end: 0;
    }

    .social-hope__heading,
    .social-hope__text {
      font-size: var(--sh-size-m);
    }

    .social-hope__button--full-mobile {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-hope__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social Hope",
  "tag": "section",
  "class": "social-hope-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen escritorio"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen móvil",
      "info": "Opcional. Se muestra en pantallas de 749 px o menos."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo",
      "info": "Si está vacío se usa el texto alternativo de la imagen."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Enlace de la imagen"
    },
    {
      "type": "text",
      "id": "image_link_label",
      "label": "Nombre accesible del enlace",
      "info": "Se usa si la imagen no tiene texto alternativo.",
      "visible_if": "{{ section.settings.image_link != blank }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción",
      "options": [
        { "value": "auto", "label": "Según la imagen" },
        { "value": "1", "label": "Cuadrada (1:1)" },
        { "value": "0.8", "label": "Vertical (4:5)" },
        { "value": "1.25", "label": "Horizontal (5:4)" },
        { "value": "1.5", "label": "Horizontal (3:2)" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Radio de esquinas",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Lado de la imagen en escritorio",
      "options": [
        { "value": "start", "label": "Izquierda" },
        { "value": "end", "label": "Derecha" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "mobile_media_order",
      "label": "Imagen en móvil",
      "options": [
        { "value": "first", "label": "Arriba" },
        { "value": "last", "label": "Abajo" }
      ],
      "default": "first"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Ancho de la imagen",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Alineación vertical",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del contenido",
      "options": [
        { "value": "start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "end", "label": "Derecha" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Ancho",
      "options": [
        { "value": "page", "label": "Contenido centrado" },
        { "value": "full", "label": "Ancho completo" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Ancho máximo del contenido",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1000,
      "visible_if": "{{ section.settings.layout_width == 'page' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Separación escritorio",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Separación móvil",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_gap",
      "label": "Separación entre botones",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo de la sección",
      "info": "Vacío usa el esquema de color."
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Superior escritorio",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Inferior escritorio",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Superior móvil",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Inferior móvil",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Tu experiencia merece ser compartida"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Etiqueta HTML",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "p", "label": "Párrafo" }
          ],
          "default": "h2"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Tamaño escritorio",
          "min": 18,
          "max": 80,
          "step": 1,
          "unit": "px",
          "default": 44
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Tamaño móvil",
          "min": 16,
          "max": 56,
          "step": 1,
          "unit": "px",
          "default": 30
        },
        {
          "type": "select",
          "id": "weight",
          "label": "Peso",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medio" },
            { "value": "600", "label": "Semi negrita" },
            { "value": "700", "label": "Negrita" },
            { "value": "800", "label": "Extra negrita" }
          ],
          "default": "700"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color"
        },
        {
          "type": "range",
          "id": "spacing_bottom",
